@page "/superadmin/create-permission"

<h1>Create Permission</h1>

<div class="form-group">
    <label for="permissionName">Permission Name:</label>
    <input type="text" id="permissionName" @bind="permissionName" class="form-control" />
</div>

<button class="btn btn-primary" @onclick="HandleCreatePermission">Create</button>

@code {
    private string permissionName;

    private async Task HandleCreatePermission()
    {
        var response = await ApiClient.PostAsync("/api/user-management/permissions", new { PermissionName = permissionName });
        if (response.IsSuccessStatusCode)
        {
            permissionName = string.Empty;
            await JSRuntime.InvokeVoidAsync("alert", "Permission created successfully!");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Failed to create permission.");
        }
    }
}