@page "/"
@layout IronMonkey.Web.Components.Layout.PublicLayout

<PageTitle>IronMonkey — Manage Every Lead, Your Way</PageTitle>

<!-- ============================================================
     HERO SECTION
     Dark gradient background: indigo-950 to indigo-600 (D-08)
     Full viewport height, centered content
     ============================================================ -->
<section class="relative min-h-screen bg-gradient-to-b from-indigo-950 to-indigo-600 flex items-center">
    <!-- Mesh decoration: radial gradient circles for depth (D-04) -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
        <div class="absolute -top-40 -right-40 w-96 h-96 rounded-full bg-indigo-400 opacity-20 blur-3xl"></div>
        <div class="absolute top-1/2 -left-32 w-80 h-80 rounded-full bg-indigo-400 opacity-15 blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-6 py-24 text-center">
        <!-- Tagline (D-01): 28px bold on desktop, scales down on mobile -->
        <h1 class="text-3xl md:text-4xl font-bold text-white leading-tight">
            Manage Every Lead, Your Way
        </h1>

        <!-- Subtitle (D-02) -->
        <p class="mt-4 max-w-2xl mx-auto text-base md:text-lg text-indigo-200 leading-relaxed">
            Configure your complete lead workflow — fields, pipelines, automation — without writing code.
        </p>

        <!-- CTA Buttons (D-03) -->
        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
            <!-- Primary: filled indigo-600, hover indigo-500 -->
            <a href="/signup"
               class="inline-flex rounded-lg bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition-colors min-h-[44px] items-center">
                Start Free
            </a>
            <!-- Secondary: outline style, indigo-300 border and text, hover indigo-50 bg -->
            <a href="/login"
               class="inline-flex rounded-lg border border-indigo-300 px-6 py-3 text-sm font-semibold text-indigo-100 hover:bg-indigo-50 hover:text-indigo-700 transition-colors min-h-[44px] items-center">
                Sign In
            </a>
        </div>
    </div>
</section>

<!-- ============================================================
     FEATURES SECTION
     White background (D-09 alternating sections)
     2x2 grid desktop, 2-col tablet, 1-col mobile (LAND-03)
     ============================================================ -->
<section class="bg-white py-24">
    <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

            <!-- Feature 1: Multi-Tenant by Default -->
            <FeatureCard Title="Multi-Tenant by Default"
                         Description="Each customer gets their own isolated database. Complete data separation with shared infrastructure."
                         Icon="@(new MarkupString(@"<svg xmlns=""http://www.w3.org/2000/svg"" fill=""none"" viewBox=""0 0 24 24"" stroke-width=""1.5"" stroke=""currentColor"" class=""w-6 h-6"">
  <path stroke-linecap=""round"" stroke-linejoin=""round"" d=""M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0 0 12 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75Z"" />
</svg>
"))" />

            <!-- Feature 2: Configurable Lead Model -->
            <FeatureCard Title="Configurable Lead Model"
                         Description="Define custom fields, statuses, and pipelines for your industry. No code required."
                         Icon="@(new MarkupString(@"<svg xmlns=""http://www.w3.org/2000/svg"" fill=""none"" viewBox=""0 0 24 24"" stroke-width=""1.5"" stroke=""currentColor"" class=""w-6 h-6"">
  <path stroke-linecap=""round"" stroke-linejoin=""round"" d=""M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75"" />
</svg>
"))" />

            <!-- Feature 3: Industry Recipes -->
            <FeatureCard Title="Industry Recipes"
                         Description="Start with pre-built workflows for SaaS, agencies, real estate, and more. Customize or start from scratch."
                         Icon="@(new MarkupString(@"<svg xmlns=""http://www.w3.org/2000/svg"" fill=""none"" viewBox=""0 0 24 24"" stroke-width=""1.5"" stroke=""currentColor"" class=""w-6 h-6"">
  <path stroke-linecap=""round"" stroke-linejoin=""round"" d=""M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z"" />
</svg>
"))" />

            <!-- Feature 4: Built-in Pipeline Management -->
            <FeatureCard Title="Built-in Pipeline Management"
                         Description="Move leads through custom stages, automate handoffs, and track progress in real time."
                         Icon="@(new MarkupString(@"<svg xmlns=""http://www.w3.org/2000/svg"" fill=""none"" viewBox=""0 0 24 24"" stroke-width=""1.5"" stroke=""currentColor"" class=""w-6 h-6"">
  <path stroke-linecap=""round"" stroke-linejoin=""round"" d=""M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"" />
</svg>
"))" />

        </div>
    </div>
</section>
