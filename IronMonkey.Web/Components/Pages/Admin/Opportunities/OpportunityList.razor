@page "/admin/opportunities"
@attribute [Authorize]
@inject IronMonkey.Web.HttpHandlers.AdminApiClient Api
@inject NavigationManager Nav
@inject TenantPresentationService Presentation
@implements IDisposable

<PageTitle>@Presentation.Terms(TerminologyTerm.Opportunity) — IronMonkey</PageTitle>

<div class="space-y-6">

    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold text-slate-900">@Presentation.Terms(TerminologyTerm.Opportunity)</h1>
        <button @onclick='() => Nav.NavigateTo("/admin/opportunities/create")'
                class="rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
            + New @Presentation.Term(TerminologyTerm.Opportunity)
        </button>
    </div>

    @if (_opportunities.Count > 0)
    {
        <div class="grid gap-4 sm:grid-cols-3">
            <div class="rounded-xl border border-slate-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Open pipeline</p>
                <p class="mt-1 text-2xl font-bold text-slate-900">@OpenValue.ToString("N0")</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Won</p>
                <p class="mt-1 text-2xl font-bold text-emerald-700">@WonValue.ToString("N0")</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Open deals</p>
                <p class="mt-1 text-2xl font-bold text-slate-900">@OpenCount</p>
            </div>
        </div>
    }

    <div class="flex flex-wrap items-center gap-3">
        <input type="search" placeholder="Search title or contact..."
               value="@_search" @oninput="OnSearchInput"
               class="w-72 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        <select @bind="_stageFilter" @bind:after="LoadAsync"
                class="rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
            <option value="">All stages</option>
            @foreach (var s in IronMonkey.Common.OpportunityStages.All)
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@_error</div>
    }

    @if (_isLoading)
    {
        <div class="py-12 text-center text-sm text-slate-500">Loading opportunities...</div>
    }
    else if (_opportunities.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 py-16 text-center">
            <p class="text-slate-600">No opportunities yet.</p>
            <p class="mt-1 text-sm text-slate-500">Create one against a contact, or convert a lead.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto rounded-lg border border-slate-200">
            <table class="w-full">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-900">Title</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-900">@Presentation.Term(TerminologyTerm.Contact)</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-900">Stage</th>
                        <th class="px-6 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-900">Amount</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-900">Expected close</th>
                        <th class="px-6 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-900">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in _opportunities)
                    {
                        <tr class="border-b border-slate-100 hover:bg-slate-50">
                            <td class="px-6 py-4 text-sm font-medium text-slate-900">
                                <button type="button" @onclick='() => Nav.NavigateTo($"/admin/opportunities/{o.Id}")'
                                        class="text-indigo-600 hover:text-indigo-700 hover:underline">@o.Title</button>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-600">@o.ContactName</td>
                            <td class="px-6 py-4">
                                <span class="inline-flex rounded-full px-2 py-1 text-xs font-semibold @StageClass(o.Stage)">@o.Stage</span>
                                @if (o.Stage == "Lost" && !string.IsNullOrWhiteSpace(o.LossReason))
                                {
                                    <span class="ml-2 text-xs text-slate-500">@o.LossReason</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right text-sm text-slate-900">@o.Amount.ToString("N0")</td>
                            <td class="px-6 py-4 text-sm text-slate-500">@o.ExpectedCloseDate.ToString("MMM d, yyyy")</td>
                            <td class="px-6 py-4 text-right space-x-2 whitespace-nowrap">
                                <button @onclick='() => Nav.NavigateTo($"/admin/opportunities/{o.Id}/edit")'
                                        class="text-sm font-medium text-indigo-600 hover:text-indigo-700">Edit</button>
                                <button @onclick="() => _deleting = o"
                                        class="text-sm font-medium text-red-600 hover:text-red-700">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_deleting is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40">
        <div class="mx-4 w-full max-w-md rounded-xl bg-white p-6 shadow-xl">
            <h3 class="mb-2 text-lg font-semibold text-slate-900">Delete @Presentation.Term(TerminologyTerm.Opportunity)</h3>
            <p class="mb-6 text-sm text-slate-600">Delete @_deleting.Title?</p>
            <div class="flex justify-end gap-3">
                <button @onclick="() => _deleting = null" class="px-4 py-2 text-sm font-medium text-slate-700">Cancel</button>
                <button @onclick="ConfirmDeleteAsync" disabled="@_isDeleting"
                        class="rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700 disabled:opacity-60">
                    @(_isDeleting ? "..." : "Delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<OpportunityItem> _opportunities = [];
    private bool _isLoading = true;
    private string? _error;
    private string _search = "";
    private string _stageFilter = "";
    private OpportunityItem? _deleting;
    private bool _isDeleting;
    private CancellationTokenSource? _debounce;

    private decimal OpenValue => _opportunities
        .Where(o => !IronMonkey.Common.OpportunityStages.IsTerminal(o.Stage)).Sum(o => o.Amount);

    private decimal WonValue => _opportunities
        .Where(o => o.Stage == IronMonkey.Common.OpportunityStages.Won).Sum(o => o.Amount);

    private int OpenCount => _opportunities
        .Count(o => !IronMonkey.Common.OpportunityStages.IsTerminal(o.Stage));

    protected override async Task OnInitializedAsync()
    {
        Presentation.Changed += OnPresentationChanged;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // After the first interactive render: the JWT is in ProtectedSessionStorage and
        // unreadable during prerender, so an earlier fetch would go out unauthenticated.
        if (firstRender)
            await Presentation.EnsureLoadedAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try { await Task.Delay(300, token); await LoadAsync(); }
        catch (TaskCanceledException) { }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            var q = new List<string>();
            if (!string.IsNullOrWhiteSpace(_search)) q.Add($"search={Uri.EscapeDataString(_search)}");
            if (!string.IsNullOrWhiteSpace(_stageFilter)) q.Add($"stage={Uri.EscapeDataString(_stageFilter)}");
            var url = "/api/opportunities" + (q.Count > 0 ? "?" + string.Join("&", q) : "");
            _opportunities = await Api.GetFromJsonAsync<List<OpportunityItem>>(url) ?? [];
        }
        catch (Exception ex) { _error = $"Failed to load opportunities: {ex.Message}"; }
        finally { _isLoading = false; StateHasChanged(); }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleting is null) return;
        _isDeleting = true;
        try
        {
            var res = await Api.DeleteAsync($"/api/opportunities/{_deleting.Id}");
            if (res.IsSuccessStatusCode) { _opportunities.Remove(_deleting); }
            else _error = "Failed to delete opportunity.";
        }
        catch (Exception ex) { _error = $"Error: {ex.Message}"; }
        finally { _isDeleting = false; _deleting = null; }
    }

    private static string StageClass(string stage) => stage switch
    {
        "Won" => "bg-emerald-100 text-emerald-800",
        "Lost" => "bg-red-100 text-red-800",
        "Negotiation" => "bg-amber-100 text-amber-800",
        "Proposal" => "bg-indigo-100 text-indigo-800",
        _ => "bg-slate-100 text-slate-700"
    };

    private class OpportunityItem
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "";
        public Guid ContactId { get; set; }
        public string ContactName { get; set; } = "";
        public string Stage { get; set; } = "";
        public decimal Amount { get; set; }
        public DateTime ExpectedCloseDate { get; set; }
        public string? LossReason { get; set; }
    }

    // Terminology is resolved once per circuit by the shared scoped service. Subscribing
    // re-renders this page if the settings arrive after it first painted — otherwise a page
    // that loaded before the fetch completed would keep the built-in labels until navigation.
    private void OnPresentationChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Presentation.Changed -= OnPresentationChanged;
}
