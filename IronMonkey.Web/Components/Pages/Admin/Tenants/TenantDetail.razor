@page "/admin/tenants/{Id:guid}"
@attribute [Authorize(Policy = AuthorizationPolicies.PlatformAdmin)]
@inject IronMonkey.Web.HttpHandlers.AdminApiClient Api
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Tenant Detail — IronMonkey Admin</PageTitle>

<div class="space-y-6">

    <div class="flex items-center justify-between gap-4">
        <div>
            <a href="/admin/tenants" class="text-sm font-medium text-indigo-600 hover:text-indigo-700">
                &larr; Back to tenants
            </a>
            <h1 class="mt-2 text-2xl font-bold text-slate-900">@(_tenant?.Name ?? "Tenant")</h1>
        </div>

        @if (_tenant is not null && _tenant.IsProvisioned)
        {
            <button type="button" @onclick="() => _showImpersonateModal = true"
                    class="rounded-lg bg-amber-700 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-800">
                Impersonate
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(_errorBanner))
    {
        <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">
            @_errorBanner
        </div>
    }

    @if (_isLoading)
    {
        <div class="py-12 text-center">
            <p class="text-sm text-slate-500">Loading...</p>
        </div>
    }
    else if (_tenant is null)
    {
        <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 py-16 text-center">
            <p class="text-slate-600">Tenant not found.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div class="rounded-xl border border-slate-200 bg-white p-5">
                <p class="text-sm font-medium text-slate-500">Status</p>
                <p class="mt-1 text-lg font-bold text-slate-900">@_tenant.Status</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
                <p class="text-sm font-medium text-slate-500">Subscription Plan</p>
                <p class="mt-1 text-lg font-bold text-slate-900">@_tenant.SubscriptionPlan</p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
                <p class="text-sm font-medium text-slate-500">Provisioned</p>
                <p class="mt-1 text-lg font-bold @(_tenant.IsProvisioned ? "text-green-600" : "text-slate-400")">
                    @(_tenant.IsProvisioned ? "Yes" : "No")
                </p>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white p-5">
                <p class="text-sm font-medium text-slate-500">Created</p>
                <p class="mt-1 text-lg font-bold text-slate-900">@_tenant.CreatedAt.ToString("yyyy-MM-dd")</p>
            </div>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-6">
            <h2 class="text-sm font-semibold text-slate-900 mb-4">Details</h2>
            <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 text-sm">
                <div>
                    <dt class="font-semibold text-slate-700">Tenant ID</dt>
                    <dd class="text-slate-600 font-mono break-all">@_tenant.Id</dd>
                </div>
                <div>
                    <dt class="font-semibold text-slate-700">Applied Recipe</dt>
                    <dd class="text-slate-600 font-mono break-all">
                        @(_tenant.AppliedRecipeId?.ToString() ?? "—")
                    </dd>
                </div>
            </dl>
        </div>

        @if (!_tenant.IsProvisioned)
        {
            <div class="rounded-lg bg-amber-50 border border-amber-200 px-4 py-3 text-sm text-amber-800">
                This tenant has no database yet, so it cannot be inspected or impersonated.
                Provision it from the tenants page first.
            </div>
        }
    }
</div>

<!-- Impersonate modal -->
@if (_showImpersonateModal && _tenant is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40">
        <div class="w-full max-w-md rounded-xl bg-white p-6 shadow-xl">
            <h2 class="text-lg font-semibold text-slate-900 mb-2">Impersonate Tenant</h2>
            <p class="text-sm text-slate-600 mb-4">
                You will act inside <span class="font-semibold">@_tenant.Name</span> as its Admin
                user for 30 minutes. Everything you do is recorded against your platform account.
            </p>
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-700 mb-1" for="reason">
                    Reason <span class="text-slate-400 text-xs">(optional)</span>
                </label>
                <textarea id="reason" rows="2" @bind="_impersonateReason"
                          placeholder="e.g. investigating a support ticket..."
                          class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </textarea>
            </div>
            <div class="flex gap-3 justify-end">
                <button type="button" @onclick="() => _showImpersonateModal = false"
                        class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                    Cancel
                </button>
                <button type="button" @onclick="HandleImpersonateAsync"
                        disabled="@_isImpersonating"
                        class="rounded-lg bg-amber-700 px-4 py-2 text-sm font-semibold text-white hover:bg-amber-800 disabled:opacity-50">
                    @(_isImpersonating ? "Starting..." : "Start impersonation")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private TenantListItem? _tenant;
    private bool _isLoading = true;
    private string? _errorBanner;

    private bool _showImpersonateModal = false;
    private string _impersonateReason = string.Empty;
    private bool _isImpersonating = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // No single-tenant endpoint exists; the list is small and already permission-gated,
            // so filter client-side rather than adding a near-duplicate API route.
            var tenants = await Api.GetFromJsonAsync<List<TenantListItem>>("/admin/tenants");
            _tenant = tenants?.FirstOrDefault(t => t.Id == Id);
        }
        catch (Exception ex)
        {
            _errorBanner = $"Failed to load tenant: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleImpersonateAsync()
    {
        if (_tenant is null)
            return;

        _isImpersonating = true;
        _errorBanner = null;

        try
        {
            var response = await Api.PostAsJsonAsync(
                $"/admin/tenants/{_tenant.Id}/impersonate",
                new { Reason = string.IsNullOrWhiteSpace(_impersonateReason) ? null : _impersonateReason });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ImpersonateResponse>();

                if (result?.Token is not null)
                {
                    var provider = (AdminAuthenticationStateProvider)AuthStateProvider;
                    await provider.ImpersonateAsync(result.Token, result.TenantName);
                    Nav.NavigateTo("/admin", forceLoad: true);
                    return;
                }

                _errorBanner = "Unexpected response from the impersonation endpoint.";
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                _errorBanner = $"Could not impersonate ({(int)response.StatusCode}). {body}";
            }
        }
        catch (Exception ex)
        {
            _errorBanner = $"Could not impersonate: {ex.Message}";
        }
        finally
        {
            _isImpersonating = false;
            _showImpersonateModal = false;
        }
    }

    private record ImpersonateResponse(
        string Token,
        Guid TenantId,
        string TenantName,
        string ImpersonatedUserEmail,
        DateTime ExpiresAt);

    private class TenantListItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public string SubscriptionPlan { get; set; } = string.Empty;
        public bool IsProvisioned { get; set; }
        public Guid? AppliedRecipeId { get; set; }
        public DateTime CreatedAt { get; set; }
    }
}
