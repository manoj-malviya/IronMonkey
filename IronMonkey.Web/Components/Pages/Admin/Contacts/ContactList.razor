@page "/admin/contacts"
@attribute [Authorize]
@inject IronMonkey.Web.HttpHandlers.AdminApiClient Api
@inject NavigationManager Nav

<PageTitle>Contacts — IronMonkey</PageTitle>

<div class="space-y-6">

    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold text-slate-900">Contacts</h1>
        <button @onclick='() => Nav.NavigateTo("/admin/contacts/create")'
                class="rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
            + New Contact
        </button>
    </div>

    <input type="search" placeholder="Search name, email or phone..."
           value="@_search" @oninput="OnSearchInput"
           class="w-72 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@_error</div>
    }

    @if (_isLoading)
    {
        <div class="py-12 text-center text-sm text-slate-500">Loading contacts...</div>
    }
    else if (_contacts.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 py-16 text-center">
            <p class="text-slate-600">No contacts yet.</p>
            <p class="mt-1 text-sm text-slate-500">Create one directly, or convert a qualified lead.</p>
            <button @onclick='() => Nav.NavigateTo("/admin/contacts/create")'
                    class="mt-4 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500">
                Create your first contact
            </button>
        </div>
    }
    else
    {
        <div class="overflow-x-auto rounded-lg border border-slate-200">
            <table class="w-full">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-900">Name</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-900">Email</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-900">Phone</th>
                        <th class="px-6 py-3 text-center text-xs font-semibold uppercase tracking-wide text-slate-900">Opportunities</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-900">Created</th>
                        <th class="px-6 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-900">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _contacts)
                    {
                        <tr class="border-b border-slate-100 hover:bg-slate-50">
                            <td class="px-6 py-4 text-sm font-medium text-slate-900">
                                <button type="button" @onclick='() => Nav.NavigateTo($"/admin/contacts/{c.Id}")'
                                        class="text-indigo-600 hover:text-indigo-700 hover:underline">@c.Name</button>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-600">@c.Email</td>
                            <td class="px-6 py-4 text-sm text-slate-600">@c.Mobile</td>
                            <td class="px-6 py-4 text-center text-sm text-slate-600">@c.OpportunityCount</td>
                            <td class="px-6 py-4 text-sm text-slate-500">@c.CreatedAt.ToString("MMM d, yyyy")</td>
                            <td class="px-6 py-4 text-right space-x-2 whitespace-nowrap">
                                <button @onclick='() => Nav.NavigateTo($"/admin/contacts/{c.Id}/edit")'
                                        class="text-sm font-medium text-indigo-600 hover:text-indigo-700">Edit</button>
                                <button @onclick="() => _deleting = c"
                                        class="text-sm font-medium text-red-600 hover:text-red-700">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_deleting is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40">
        <div class="mx-4 w-full max-w-md rounded-xl bg-white p-6 shadow-xl">
            <h3 class="mb-2 text-lg font-semibold text-slate-900">Delete Contact</h3>
            <p class="mb-6 text-sm text-slate-600">Delete @_deleting.Name?</p>
            <div class="flex justify-end gap-3">
                <button @onclick="() => _deleting = null" class="px-4 py-2 text-sm font-medium text-slate-700">Cancel</button>
                <button @onclick="ConfirmDeleteAsync" disabled="@_isDeleting"
                        class="rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700 disabled:opacity-60">
                    @(_isDeleting ? "..." : "Delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ContactItem> _contacts = [];
    private bool _isLoading = true;
    private string? _error;
    private string _search = "";
    private ContactItem? _deleting;
    private bool _isDeleting;
    private CancellationTokenSource? _debounce;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try { await Task.Delay(300, token); await LoadAsync(); }
        catch (TaskCanceledException) { }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            var url = string.IsNullOrWhiteSpace(_search)
                ? "/api/contacts"
                : $"/api/contacts?search={Uri.EscapeDataString(_search)}";
            _contacts = await Api.GetFromJsonAsync<List<ContactItem>>(url) ?? [];
        }
        catch (Exception ex) { _error = $"Failed to load contacts: {ex.Message}"; }
        finally { _isLoading = false; StateHasChanged(); }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleting is null) return;
        _isDeleting = true;
        try
        {
            var res = await Api.DeleteAsync($"/api/contacts/{_deleting.Id}");
            if (res.IsSuccessStatusCode) { _contacts.Remove(_deleting); _deleting = null; }
            else
            {
                // Most often: the contact still has opportunities attached.
                _error = await res.Content.ReadAsStringAsync();
                _deleting = null;
            }
        }
        catch (Exception ex) { _error = $"Error: {ex.Message}"; _deleting = null; }
        finally { _isDeleting = false; }
    }

    private class ContactItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Mobile { get; set; } = "";
        public int OpportunityCount { get; set; }
        public DateTime CreatedAt { get; set; }
    }
}
