@page "/admin/recipes/{Id:guid}/edit"
@attribute [Authorize]
@using IronMonkey.Data.RecipeContent
@using IronMonkey.Web.Components.Pages.Admin.Recipes.Shared
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav

<PageTitle>Edit Recipe — IronMonkey Admin</PageTitle>

<div class="max-w-3xl">

    @if (_isLoading && _recipe == null)
    {
        <p class="text-sm text-slate-500 py-12 text-center">Loading recipe...</p>
    }
    else if (!_isLoading && _recipe == null)
    {
        <p class="text-red-600">Recipe not found.</p>
    }
    else if (_recipe != null)
    {
        <!-- Header row -->
        <div class="mb-6 flex items-start justify-between">
            <div>
                <button type="button" @onclick='() => Nav.NavigateTo("/admin/recipes")'
                        class="mb-2 text-sm text-indigo-600 hover:text-indigo-700">
                    ← Back to Recipes
                </button>
                <h1 class="text-2xl font-bold text-slate-900">Edit Recipe: @_recipe.Name</h1>
            </div>
            <button type="button" @onclick="NavigateToPreview"
                    class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 shrink-0">
                Preview
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_errorBanner))
        {
            <div class="mb-4 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">
                @_errorBanner
            </div>
        }

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="mb-4 rounded-lg bg-green-50 border border-green-200 px-4 py-3 text-sm text-green-700">
                @_successMessage
            </div>
        }

        <!-- Metadata read-only display -->
        <div class="rounded-lg border border-slate-200 bg-white p-6 mb-6">
            <h2 class="text-base font-semibold text-slate-900 mb-4">Recipe Details</h2>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="mb-1 block text-xs font-medium text-slate-500 uppercase tracking-wide">Name</label>
                    <p class="text-sm text-slate-700">@_recipe.Name</p>
                </div>
                <div>
                    <label class="mb-1 block text-xs font-medium text-slate-500 uppercase tracking-wide">Industry</label>
                    <p class="text-sm text-slate-700">@(_listItem?.IndustrySlug ?? "—")</p>
                </div>
                <div>
                    <label class="mb-1 block text-xs font-medium text-slate-500 uppercase tracking-wide">Icon</label>
                    <p class="text-sm text-slate-700">@(_listItem?.IconIdentifier ?? "—")</p>
                </div>
                <div>
                    <label class="mb-1 block text-xs font-medium text-slate-500 uppercase tracking-wide">Version</label>
                    <p class="text-sm text-slate-700">v@(_listItem?.Version.ToString() ?? "—")</p>
                </div>
            </div>
            <p class="mt-3 text-xs text-slate-500">Recipe metadata (name, industry, icon) was set at creation and cannot be changed. Only content sections can be edited.</p>
        </div>

        <!-- EditForm for content sections -->
        <EditForm Model="_content" OnValidSubmit="HandleSaveAsync">

            <RecipeContentEditor Content="_content" />

            <div class="mt-6 flex justify-end gap-3">
                <button type="button" @onclick='() => Nav.NavigateTo("/admin/recipes")'
                        class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">
                    Cancel
                </button>
                <button type="submit" disabled="@_isSaving"
                        class="rounded-lg bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 disabled:opacity-60 disabled:cursor-not-allowed">
                    @(_isSaving ? "Saving..." : "Save Changes")
                </button>
            </div>

        </EditForm>
    }

</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private RecipePreviewDto? _recipe = null;
    private RecipeListItem? _listItem = null;
    private RecipeContentModel _content = new();
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string? _errorBanner = null;
    private string? _successMessage = null;

    private void NavigateToPreview() => Nav.NavigateTo($"/admin/recipes/{Id}/preview");

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            var client = HttpClientFactory.CreateClient("AdminApi");

            // Fetch full recipe content
            var preview = await client.GetFromJsonAsync<RecipePreviewDto>($"/api/recipes/{Id}");
            _recipe = preview;
            if (preview is not null)
                _content = preview.Content ?? new RecipeContentModel();

            // Fetch metadata (IndustrySlug, IconIdentifier, IsBlank, Version) from list endpoint
            var list = await client.GetFromJsonAsync<List<RecipeListItem>>("/api/recipes");
            _listItem = list?.FirstOrDefault(r => r.Id == Id);
        }
        catch (Exception ex)
        {
            _errorBanner = $"Failed to load recipe: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleSaveAsync()
    {
        _isSaving = true;
        _errorBanner = null;
        _successMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("AdminApi");
            var payload = new { Content = _content };
            var response = await client.PutAsJsonAsync($"/api/recipes/{Id}", payload);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<RecipeUpdateResponse>();
                _successMessage = $"Recipe saved. Version: v{result?.NewVersion}";
                // Refresh list item to show updated version
                if (_listItem is not null && result is not null)
                    _listItem = _listItem with { Version = result.NewVersion };
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Nav.NavigateTo("/login");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _errorBanner = "Recipe not found or has been deactivated.";
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                _errorBanner = $"Failed to save: {errorBody}";
            }
        }
        catch (Exception ex)
        {
            _errorBanner = $"Unable to save recipe: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private record RecipePreviewDto(Guid Id, string Name, string Description, RecipeContentModel Content);
    private record RecipeUpdateResponse(Guid RecipeId, int NewVersion, string Message);
    private record RecipeListItem(Guid Id, string Name, string Description, string IconIdentifier, string IndustrySlug, bool IsBlank, int Version, int StageCount, int FieldCount, int RuleCount, int RoleCount);
}
