@page "/admin/recipes/{Id:guid}/preview"
@attribute [Authorize]
@using IronMonkey.Data.RecipeContent
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav

<PageTitle>Preview Recipe — IronMonkey Admin</PageTitle>

<div>

    @if (_isLoading)
    {
        <p class="text-sm text-slate-500 py-12 text-center">Loading preview...</p>
    }
    else if (_recipe == null)
    {
        <p class="text-red-600">Recipe not found or has been deactivated.</p>
    }
    else
    {
        <!-- Heading row -->
        <div class="mb-6 flex items-start justify-between">
            <div>
                <button type="button" @onclick='() => Nav.NavigateTo("/admin/recipes")'
                        class="mb-2 text-sm text-indigo-600 hover:text-indigo-700">← Back to Recipes</button>
                <h1 class="text-2xl font-bold text-slate-900">@_recipe.Name</h1>
                @if (!string.IsNullOrEmpty(_recipe.Description))
                {
                    <p class="mt-1 text-sm text-slate-500">@_recipe.Description</p>
                }
            </div>
            <button type="button" @onclick="NavigateToEdit"
                    class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 shrink-0">
                Edit Recipe
            </button>
        </div>

        <!-- Tabs -->
        <div class="border-b border-slate-200 mb-6">
            <nav class="flex space-x-8">
                @foreach (var tab in _tabs)
                {
                    <button type="button" @onclick="() => _activeTab = tab"
                            class="@(tab == _activeTab
                                ? "border-b-2 border-indigo-600 text-indigo-600 font-medium"
                                : "text-slate-600 hover:text-slate-900") px-1 py-4 text-sm transition-colors">
                        @tab
                    </button>
                }
            </nav>
        </div>

        <!-- Tab content -->
        @if (_activeTab == "Stages")
        {
            @if (_recipe.Content.PipelineStages.Count == 0)
            {
                <p class="text-sm text-slate-500">No pipeline stages defined.</p>
            }
            else
            {
                <div class="overflow-x-auto rounded-lg border border-slate-200">
                    <table class="w-full">
                        <thead class="bg-slate-50 border-b border-slate-200">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Order</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Name</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Stage Type</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stage in _recipe.Content.PipelineStages.OrderBy(s => s.Order))
                            {
                                <tr class="border-b border-slate-100 hover:bg-slate-50">
                                    <td class="px-6 py-4 text-sm text-slate-700">@stage.Order</td>
                                    <td class="px-6 py-4 text-sm text-slate-700">@stage.Name</td>
                                    <td class="px-6 py-4 text-sm text-slate-700">@stage.StageType</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else if (_activeTab == "Fields")
        {
            @if (_recipe.Content.CustomFields.Count == 0)
            {
                <p class="text-sm text-slate-500">No custom fields defined.</p>
            }
            else
            {
                <div class="overflow-x-auto rounded-lg border border-slate-200">
                    <table class="w-full">
                        <thead class="bg-slate-50 border-b border-slate-200">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Field Name</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Type</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Required</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Options</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var field in _recipe.Content.CustomFields)
                            {
                                <tr class="border-b border-slate-100 hover:bg-slate-50">
                                    <td class="px-6 py-4 text-sm text-slate-700">@field.FieldName</td>
                                    <td class="px-6 py-4 text-sm text-slate-700">@field.FieldType</td>
                                    <td class="px-6 py-4 text-sm text-slate-700">@(field.IsRequired ? "✓" : "—")</td>
                                    <td class="px-6 py-4 text-sm text-slate-700">@(field.Options.Count > 0 ? string.Join(", ", field.Options) : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else if (_activeTab == "Rules")
        {
            @if (_recipe.Content.WorkflowRules.Count == 0)
            {
                <p class="text-sm text-slate-500">No workflow rules defined.</p>
            }
            else
            {
                <div class="overflow-x-auto rounded-lg border border-slate-200">
                    <table class="w-full">
                        <thead class="bg-slate-50 border-b border-slate-200">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Name</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Trigger</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Condition</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rule in _recipe.Content.WorkflowRules)
                            {
                                <tr class="border-b border-slate-100 hover:bg-slate-50">
                                    <td class="px-6 py-4 text-sm text-slate-700">@rule.Name</td>
                                    <td class="px-6 py-4 text-sm text-slate-700">@rule.Trigger</td>
                                    <td class="px-6 py-4 text-sm text-slate-700"><code class="text-xs font-mono bg-slate-50 px-1 rounded">@rule.ConditionJson</code></td>
                                    <td class="px-6 py-4 text-sm text-slate-700"><code class="text-xs font-mono bg-slate-50 px-1 rounded">@rule.ActionJson</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else if (_activeTab == "Roles")
        {
            @if (_recipe.Content.Roles.Count == 0)
            {
                <p class="text-sm text-slate-500">No roles defined.</p>
            }
            else
            {
                <div class="overflow-x-auto rounded-lg border border-slate-200">
                    <table class="w-full">
                        <thead class="bg-slate-50 border-b border-slate-200">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Name</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in _recipe.Content.Roles)
                            {
                                <tr class="border-b border-slate-100 hover:bg-slate-50">
                                    <td class="px-6 py-4 text-sm text-slate-700">@role.Name</td>
                                    <td class="px-6 py-4 text-sm text-slate-700">@role.Description</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else if (_activeTab == "Sample Leads")
        {
            @if (_recipe.Content.SampleLeads.Count == 0)
            {
                <p class="text-sm text-slate-500">No sample leads defined.</p>
            }
            else
            {
                <div class="overflow-x-auto rounded-lg border border-slate-200">
                    <table class="w-full">
                        <thead class="bg-slate-50 border-b border-slate-200">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">First Name</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Last Name</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Email</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Stage</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Source</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lead in _recipe.Content.SampleLeads)
                            {
                                <tr class="border-b border-slate-100 hover:bg-slate-50">
                                    <td class="px-6 py-4 text-sm text-slate-700">@lead.FirstName</td>
                                    <td class="px-6 py-4 text-sm text-slate-700">@lead.LastName</td>
                                    <td class="px-6 py-4 text-sm text-slate-700">@lead.Email</td>
                                    <td class="px-6 py-4 text-sm text-slate-700">@lead.StageName</td>
                                    <td class="px-6 py-4 text-sm text-slate-700">@lead.Source</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    }

</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private RecipePreviewDto? _recipe = null;
    private bool _isLoading = true;
    private string _activeTab = "Stages";
    private readonly string[] _tabs = ["Stages", "Fields", "Rules", "Roles", "Sample Leads"];

    private void NavigateToEdit() => Nav.NavigateTo($"/admin/recipes/{Id}/edit");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("AdminApi");
            _recipe = await client.GetFromJsonAsync<RecipePreviewDto>($"/api/recipes/{Id}");
        }
        catch (Exception)
        {
            // _recipe remains null → not found state shown
        }
        finally
        {
            _isLoading = false;
        }
    }

    private record RecipePreviewDto(Guid Id, string Name, string Description, RecipeContentModel Content);
}
