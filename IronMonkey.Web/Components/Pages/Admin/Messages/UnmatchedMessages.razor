@page "/admin/messages/unmatched"
@attribute [Authorize]
@inject IronMonkey.Web.HttpHandlers.AdminApiClient Api
@using IronMonkey.Web.Communications
@using System.Net.Http.Json

<PageTitle>Unmatched messages — IronMonkey</PageTitle>

@* Inbound messages whose sender could not be matched to a lead or contact. They are kept and
   shown here rather than dropped: an unmatched reply is usually a real customer whose number
   is recorded differently, and discarding it loses their message. *@

<div class="space-y-6">

    <div>
        <h1 class="text-xl font-semibold text-slate-900">Unmatched messages</h1>
        <p class="mt-1 text-sm text-slate-500">
            Replies we received but could not match to a record. Attach one to put it on that
            record's timeline.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">@_error</div>
    }

    @if (!string.IsNullOrEmpty(_success))
    {
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-700">@_success</div>
    }

    @if (_isLoading)
    {
        <p class="py-8 text-center text-sm text-slate-500">Loading...</p>
    }
    else if (_messages.Count == 0)
    {
        <div class="rounded-xl border border-slate-200 bg-white py-12 text-center">
            <p class="text-sm text-slate-500">Nothing to review — every inbound message matched a record.</p>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var message in _messages)
            {
                <div class="rounded-xl border border-slate-200 bg-white p-5">
                    <div class="mb-2 flex flex-wrap items-baseline gap-x-3">
                        <span class="text-sm font-semibold text-slate-900">@message.From</span>
                        <span class="rounded bg-slate-200 px-1.5 py-0.5 text-[10px] font-medium text-slate-600">@message.Channel</span>
                        <span class="text-xs text-slate-400">@message.QueuedAt.ToString("f")</span>
                    </div>

                    @if (!string.IsNullOrEmpty(message.Subject))
                    {
                        <p class="text-sm font-medium text-slate-900">@message.Subject</p>
                    }

                    @* Rendered as text: the body was written by whoever sent it. *@
                    <p class="whitespace-pre-wrap text-sm text-slate-700">@message.Body</p>

                    <div class="mt-3 flex flex-wrap items-center gap-2">
                        <input placeholder="Lead ID"
                               value="@GetDraft(message.Id)"
                               @oninput="e => SetDraft(message.Id, e.Value?.ToString())"
                               class="w-80 rounded-lg border border-slate-300 px-3 py-1.5 text-xs" />
                        <button type="button" @onclick="() => AttachAsync(message.Id)"
                                class="rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-500">
                            Attach to lead
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private readonly List<MessageItem> _messages = [];
    private readonly Dictionary<Guid, string> _drafts = [];
    private bool _isLoading = true;
    private string? _error;
    private string? _success;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The JWT is unreadable during prerender, so this waits for the first interactive render.
        if (!firstRender) return;

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var page = await Api.GetFromJsonAsync<MessagePage>("/api/messages?unmatched=true");

            _messages.Clear();
            if (page is not null) _messages.AddRange(page.Items);
        }
        catch (Exception ex) { _error = $"Failed to load messages: {ex.Message}"; }
        finally { _isLoading = false; }
    }

    private string GetDraft(Guid id) => _drafts.TryGetValue(id, out var value) ? value : "";

    private void SetDraft(Guid id, string? value) => _drafts[id] = value ?? "";

    private async Task AttachAsync(Guid messageId)
    {
        _error = null;
        _success = null;

        if (!Guid.TryParse(GetDraft(messageId), out var leadId))
        {
            _error = "Enter a valid lead ID.";
            return;
        }

        try
        {
            var response = await Api.PutAsJsonAsync($"/api/messages/{messageId}/attach",
                new { LeadId = leadId, ContactId = (Guid?)null });

            if (!response.IsSuccessStatusCode)
            {
                _error = response.StatusCode == System.Net.HttpStatusCode.NotFound
                    ? "No lead with that ID exists in this organisation."
                    : $"Failed to attach the message ({(int)response.StatusCode}).";
                return;
            }

            _drafts.Remove(messageId);
            _success = "Message attached.";
            await LoadAsync();
        }
        catch (Exception ex) { _error = $"Failed to attach: {ex.Message}"; }
    }
}
