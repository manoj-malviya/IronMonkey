@page "/admin/configuration"
@attribute [Authorize]
@inject IHttpClientFactory HttpClientFactory

<PageTitle>System Configuration — IronMonkey Admin</PageTitle>

<div class="space-y-6">

    <h1 class="text-2xl font-bold text-slate-900">System Configuration</h1>

    <!-- Tab selector -->
    <div class="border-b border-slate-200">
        <nav class="flex space-x-8">
            @foreach (var tab in _tabs)
            {
                <button type="button" @onclick="() => SetTab(tab)"
                        class="@(tab == _activeTab
                            ? "border-b-2 border-indigo-600 text-indigo-600 font-medium"
                            : "text-slate-600 hover:text-slate-900") px-1 py-4 text-sm transition-colors">
                    @tab
                </button>
            }
        </nav>
    </div>

    <!-- Error banner -->
    @if (!string.IsNullOrEmpty(_errorBanner))
    {
        <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">
            @_errorBanner
        </div>
    }

    <!-- Success banner -->
    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="rounded-lg bg-green-50 border border-green-200 px-4 py-3 text-sm text-green-700">
            @_successMessage
        </div>
    }

    <!-- PIPELINE STAGES TAB -->
    @if (_activeTab == "Pipeline Stages")
    {
        @if (_isLoading)
        {
            <div class="py-12 text-center">
                <p class="text-sm text-slate-500">Loading...</p>
            </div>
        }
        else if (_stages.Count == 0 && !_creatingStage)
        {
            <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 py-16 text-center">
                <p class="text-slate-600">No pipeline stages configured. Add your first stage to get started.</p>
                <button type="button" @onclick="StartAddStage"
                        class="mt-4 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">
                    + Add Stage
                </button>
            </div>
        }
        else
        {
            <div class="overflow-x-auto rounded-lg border border-slate-200">
                <table class="w-full">
                    <thead class="bg-slate-50 border-b border-slate-200">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Order</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Name</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Status</th>
                            <th class="px-6 py-3 text-right text-xs font-semibold text-slate-900 uppercase tracking-wide">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stage in _stages.OrderBy(s => s.Order))
                        {
                            @if (_editingStageId == stage.Id)
                            {
                                <!-- Edit mode row -->
                                <tr @key="stage.Id" class="border-b border-slate-100 bg-indigo-50">
                                    <td colspan="4" class="px-6 py-4">
                                        <div class="flex flex-wrap gap-3 items-end">
                                            <div>
                                                <label class="block text-xs font-semibold text-slate-900 uppercase tracking-wider mb-1">Name</label>
                                                <input type="text" @bind="_editingStage!.Name"
                                                       class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600" />
                                            </div>
                                            <div class="flex gap-2">
                                                <button type="button" @onclick="CancelEditStage"
                                                        class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                                                    Cancel
                                                </button>
                                                <button type="button" @onclick="SaveEditStageAsync" disabled="@_isSaving"
                                                        class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 disabled:opacity-50">
                                                    @(_isSaving ? "Saving..." : "Save")
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <!-- Display mode row -->
                                <tr @key="stage.Id" class="border-b border-slate-100 hover:bg-slate-50">
                                    <td class="px-6 py-4 text-sm text-slate-900">@stage.Order</td>
                                    <td class="px-6 py-4 text-sm text-slate-900">@stage.Name</td>
                                    <td class="px-6 py-4 text-sm text-slate-600">
                                        @if (stage.IsActive)
                                        {
                                            <span class="inline-flex items-center rounded-full px-2 py-1 text-xs font-semibold bg-green-100 text-green-800">Active</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center rounded-full px-2 py-1 text-xs font-semibold bg-slate-100 text-slate-600">Inactive</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right space-x-1">
                                        <!-- Up arrow -->
                                        <button type="button" @onclick="() => MoveStageUpAsync(stage.Id)"
                                                disabled="@(stage.Order == _stages.Min(s => s.Order))"
                                                title="Move up"
                                                class="p-1 rounded text-slate-600 hover:bg-slate-100 disabled:text-slate-300">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" />
                                            </svg>
                                        </button>
                                        <!-- Down arrow -->
                                        <button type="button" @onclick="() => MoveStageDownAsync(stage.Id)"
                                                disabled="@(stage.Order == _stages.Max(s => s.Order))"
                                                title="Move down"
                                                class="p-1 rounded text-slate-600 hover:bg-slate-100 disabled:text-slate-300">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
                                            </svg>
                                        </button>
                                        <button type="button" @onclick="() => StartEditStage(stage)"
                                                class="text-sm font-medium text-indigo-600 hover:text-indigo-700">
                                            Edit
                                        </button>
                                        <button type="button" @onclick="() => OpenDeleteStageConfirm(stage.Id)"
                                                class="text-sm font-medium text-red-600 hover:text-red-700">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        }

                        <!-- Add Stage row -->
                        @if (_creatingStage && _editingStageId == null)
                        {
                            <tr class="border-b border-slate-100 bg-indigo-50">
                                <td colspan="4" class="px-6 py-4">
                                    <div class="flex flex-wrap gap-3 items-end">
                                        <div>
                                            <label class="block text-xs font-semibold text-slate-900 uppercase tracking-wider mb-1">Name</label>
                                            <input type="text" @bind="_newStageName" placeholder="Stage name"
                                                   class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600" />
                                        </div>
                                        <div class="flex gap-2">
                                            <button type="button" @onclick="CancelAddStage"
                                                    class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                                                Cancel
                                            </button>
                                            <button type="button" @onclick="SaveNewStageAsync" disabled="@_isSaving"
                                                    class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 disabled:opacity-50">
                                                @(_isSaving ? "Saving..." : "Create")
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Add Stage button (below table) -->
            <div class="mt-4">
                <button type="button" @onclick="StartAddStage"
                        disabled="@(_creatingStage || _editingStageId != null)"
                        class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 disabled:opacity-50">
                    + Add Stage
                </button>
            </div>
        }
    }

    <!-- CUSTOM FIELDS TAB -->
    @if (_activeTab == "Custom Fields")
    {
        @if (_isLoading)
        {
            <div class="py-12 text-center">
                <p class="text-sm text-slate-500">Loading...</p>
            </div>
        }
        else if (_fields.Count == 0 && !_creatingField)
        {
            <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 py-16 text-center">
                <p class="text-slate-600">No custom fields defined. Add fields to capture tenant-specific lead data.</p>
                <button type="button" @onclick="StartAddField"
                        class="mt-4 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">
                    + Add Field
                </button>
            </div>
        }
        else
        {
            <div class="overflow-x-auto rounded-lg border border-slate-200">
                <table class="w-full">
                    <thead class="bg-slate-50 border-b border-slate-200">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Name</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Type</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Required</th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Options</th>
                            <th class="px-6 py-3 text-right text-xs font-semibold text-slate-900 uppercase tracking-wide">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var field in _fields)
                        {
                            @if (_editingFieldId == field.Id)
                            {
                                <!-- Edit mode row -->
                                <tr @key="field.Id" class="border-b border-slate-100 bg-indigo-50">
                                    <td colspan="5" class="px-6 py-4">
                                        <div class="flex flex-wrap gap-3 items-end">
                                            <div>
                                                <label class="block text-xs font-semibold text-slate-900 uppercase tracking-wider mb-1">Name</label>
                                                <input type="text" @bind="_editingField!.FieldName"
                                                       class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600" />
                                            </div>
                                            <div>
                                                <label class="block text-xs font-semibold text-slate-900 uppercase tracking-wider mb-1">Type</label>
                                                <select @bind="_editingField!.FieldType"
                                                        class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600">
                                                    <option value="Text">Text</option>
                                                    <option value="Number">Number</option>
                                                    <option value="Date">Date</option>
                                                    <option value="Dropdown">Dropdown</option>
                                                    <option value="MultiSelect">MultiSelect</option>
                                                    <option value="Currency">Currency</option>
                                                    <option value="Boolean">Boolean</option>
                                                </select>
                                            </div>
                                            <div class="flex items-center gap-1 mt-4">
                                                <input type="checkbox" @bind="_editingField!.IsRequired" class="rounded border-slate-300" />
                                                <label class="text-sm text-slate-700 ml-1">Required</label>
                                            </div>
                                            @if (_editingField!.FieldType is "Dropdown" or "MultiSelect")
                                            {
                                                <div>
                                                    <label class="block text-xs font-semibold text-slate-900 uppercase tracking-wider mb-1">Options (comma-separated)</label>
                                                    <input type="text" @bind="_editingFieldOptions" placeholder="Option A, Option B"
                                                           class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600 w-64" />
                                                </div>
                                            }
                                            <div class="flex gap-2">
                                                <button type="button" @onclick="CancelEditField"
                                                        class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                                                    Cancel
                                                </button>
                                                <button type="button" @onclick="SaveEditFieldAsync" disabled="@_isSaving"
                                                        class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 disabled:opacity-50">
                                                    @(_isSaving ? "Saving..." : "Save")
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <!-- Display mode row -->
                                <tr @key="field.Id" class="border-b border-slate-100 hover:bg-slate-50">
                                    <td class="px-6 py-4 text-sm text-slate-900">@field.FieldName</td>
                                    <td class="px-6 py-4 text-sm text-slate-600">@field.FieldType</td>
                                    <td class="px-6 py-4">
                                        @if (field.IsRequired)
                                        {
                                            <span class="bg-indigo-50 text-indigo-700 text-xs font-medium px-2 py-0.5 rounded-full">Required</span>
                                        }
                                        else
                                        {
                                            <span class="text-slate-400 text-xs">—</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-sm text-slate-600">
                                        @if ((field.FieldType is "Dropdown" or "MultiSelect") && field.Options.Count > 0)
                                        {
                                            @string.Join(", ", field.Options)
                                        }
                                        else
                                        {
                                            <span class="text-slate-400">—</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-right space-x-1">
                                        <button type="button" @onclick="() => StartEditField(field)"
                                                class="text-sm font-medium text-indigo-600 hover:text-indigo-700">
                                            Edit
                                        </button>
                                        <button type="button" @onclick="() => OpenDeleteFieldConfirm(field.Id)"
                                                class="text-sm font-medium text-red-600 hover:text-red-700">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        }

                        <!-- Add Field row -->
                        @if (_creatingField && _editingFieldId == null)
                        {
                            <tr class="border-b border-slate-100 bg-indigo-50">
                                <td colspan="5" class="px-6 py-4">
                                    <div class="flex flex-wrap gap-3 items-end">
                                        <div>
                                            <label class="block text-xs font-semibold text-slate-900 uppercase tracking-wider mb-1">Name</label>
                                            <input type="text" @bind="_newFieldName" placeholder="Field name"
                                                   class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600" />
                                        </div>
                                        <div>
                                            <label class="block text-xs font-semibold text-slate-900 uppercase tracking-wider mb-1">Type</label>
                                            <select @bind="_newFieldType"
                                                    class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600">
                                                <option value="Text">Text</option>
                                                <option value="Number">Number</option>
                                                <option value="Date">Date</option>
                                                <option value="Dropdown">Dropdown</option>
                                                <option value="MultiSelect">MultiSelect</option>
                                                <option value="Currency">Currency</option>
                                                <option value="Boolean">Boolean</option>
                                            </select>
                                        </div>
                                        <div class="flex items-center gap-1 mt-4">
                                            <input type="checkbox" @bind="_newFieldRequired" class="rounded border-slate-300" />
                                            <label class="text-sm text-slate-700 ml-1">Required</label>
                                        </div>
                                        @if (_newFieldType is "Dropdown" or "MultiSelect")
                                        {
                                            <div>
                                                <label class="block text-xs font-semibold text-slate-900 uppercase tracking-wider mb-1">Options (comma-separated)</label>
                                                <input type="text" @bind="_newFieldOptions" placeholder="Option A, Option B"
                                                       class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600 w-64" />
                                            </div>
                                        }
                                        <div class="flex gap-2">
                                            <button type="button" @onclick="CancelAddField"
                                                    class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                                                Cancel
                                            </button>
                                            <button type="button" @onclick="SaveNewFieldAsync" disabled="@_isSaving"
                                                    class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 disabled:opacity-50">
                                                @(_isSaving ? "Saving..." : "Create")
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Add Field button (below table) -->
            <div class="mt-4">
                <button type="button" @onclick="StartAddField"
                        disabled="@(_creatingField || _editingFieldId != null)"
                        class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 disabled:opacity-50">
                    + Add Field
                </button>
            </div>
        }
    }

    <!-- ROUTING TAB -->
    @if (_activeTab == "Routing")
    {
        @if (_isLoading)
        {
            <div class="py-12 text-center">
                <p class="text-sm text-slate-500">Loading...</p>
            </div>
        }
        else
        {
            <div class="space-y-6 max-w-2xl">
                <div>
                    <p class="text-sm font-semibold text-slate-900 mb-4">Lead Assignment Strategy</p>
                    <div class="flex gap-6">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="routingMode" value="RoundRobin"
                                   checked="@(_routingMode == "RoundRobin")"
                                   @onchange="@((ChangeEventArgs e) => _routingMode = (string?)e.Value ?? "RoundRobin")"
                                   class="border-slate-300" />
                            <span class="text-sm text-slate-700">Round-Robin</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="radio" name="routingMode" value="Territory"
                                   checked="@(_routingMode == "Territory")"
                                   @onchange="@((ChangeEventArgs e) => _routingMode = (string?)e.Value ?? "RoundRobin")"
                                   class="border-slate-300" />
                            <span class="text-sm text-slate-700">Territory-Based</span>
                        </label>
                    </div>
                </div>

                @if (_routingMode == "Territory")
                {
                    <div>
                        <label class="block text-xs font-semibold text-slate-900 uppercase tracking-wider mb-2">
                            Territory Rules (JSON)
                        </label>
                        <textarea @bind="_territoryJson"
                                  placeholder='[{"territory": "West", "states": ["CA", "OR"]}]'
                                  class="w-full h-48 rounded-lg border border-slate-300 px-4 py-3 font-mono text-sm text-slate-900 focus:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600"></textarea>
                    </div>
                }

                <div class="flex justify-end">
                    <button @onclick="SaveRoutingConfigAsync" disabled="@_isSaving"
                            class="rounded-lg bg-indigo-600 px-6 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700 disabled:opacity-50">
                        @(_isSaving ? "Saving..." : "Save Configuration")
                    </button>
                </div>
            </div>
        }
    }

    <!-- WORKFLOW RULES TAB -->
    @if (_activeTab == "Workflow Rules")
    {
        <p class="text-sm text-slate-500 py-8">Coming soon.</p>
    }

</div>

<!-- Delete confirmation modal -->
@if (_showDeleteConfirm)
{
    <div class="fixed inset-0 z-50 bg-black/40 flex items-center justify-center p-4">
        <div class="bg-white rounded-lg shadow-lg max-w-sm w-full">
            <div class="px-6 py-4 border-b border-slate-200">
                <h3 class="text-lg font-semibold text-slate-900">@_deleteModalTitle</h3>
            </div>
            <div class="px-6 py-4">
                <p class="text-sm text-slate-600">@_deleteModalMessage</p>
            </div>
            <div class="px-6 py-4 border-t border-slate-200 flex gap-2 justify-end">
                <button type="button" @onclick="CancelDelete"
                        class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                    Cancel
                </button>
                <button type="button" @onclick="ConfirmDeleteAsync" disabled="@_isSaving"
                        class="rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700 disabled:opacity-50">
                    @(_isSaving ? "Deleting..." : "Delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    // Tab state
    private readonly string[] _tabs = ["Pipeline Stages", "Custom Fields", "Routing", "Workflow Rules"];
    private string _activeTab = "Pipeline Stages";
    private bool _isLoading = false;
    private bool _isSaving = false;
    private string? _errorBanner = null;
    private string? _successMessage = null;

    // Pipeline Stages
    private List<StageItem> _stages = new();
    private bool _stagesLoaded = false;
    private Guid? _editingStageId = null;
    private StageItem? _editingStage = null;
    private bool _creatingStage = false;
    private string _newStageName = string.Empty;

    // Custom Fields state
    private List<FieldItem> _fields = new();
    private bool _fieldsLoaded = false;
    private Guid? _editingFieldId = null;
    private FieldItem? _editingField = null;
    private string _editingFieldOptions = string.Empty;
    private bool _creatingField = false;
    private string _newFieldName = string.Empty;
    private string _newFieldType = "Text";
    private bool _newFieldRequired = false;
    private string _newFieldOptions = string.Empty;

    // Delete modal (shared across all tabs)
    private bool _showDeleteConfirm = false;
    private string _deleteModalTitle = string.Empty;
    private string _deleteModalMessage = string.Empty;
    private Guid _deletingItemId = Guid.Empty;
    private string _deletingItemType = string.Empty; // "stage", "field", "rule"

    // Local DTO for stages — matches ListPipelineStagesEndpoint response (Id, Name, Order, IsActive)
    private class StageItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public int Order { get; set; }
        public bool IsActive { get; set; }
    }

    // Local DTO for custom fields — matches ListCustomFieldsEndpoint response (Id, FieldName, FieldType, IsRequired, Options)
    private class FieldItem
    {
        public Guid Id { get; set; }
        public string FieldName { get; set; } = string.Empty;
        public string FieldType { get; set; } = "Text";
        public bool IsRequired { get; set; }
        public List<string> Options { get; set; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadStagesAsync();
    }

    private void SetTab(string tab)
    {
        _activeTab = tab;
        _errorBanner = null;
        if (tab == "Pipeline Stages" && !_stagesLoaded)
        {
            _ = LoadStagesAsync();
        }
        else if (tab == "Custom Fields" && !_fieldsLoaded)
        {
            _ = LoadFieldsAsync();
        }
        else if (tab == "Routing" && !_routingLoaded)
        {
            _ = LoadRoutingConfigAsync();
        }
    }

    private async Task LoadStagesAsync()
    {
        _isLoading = true;
        _errorBanner = null;
        try
        {
            var client = HttpClientFactory.CreateClient("AdminApi");
            var stages = await client.GetFromJsonAsync<List<StageItem>>("/api/pipeline-stages");
            _stages = (stages ?? []).OrderBy(s => s.Order).ToList();
            _stagesLoaded = true;
        }
