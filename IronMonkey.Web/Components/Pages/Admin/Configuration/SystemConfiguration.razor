    private async Task MoveStageUpAsync(Guid id)
    {
        var stage = _stages.FirstOrDefault(s => s.Id == id);
        if (stage is null) return;

        var above = _stages.Where(s => s.Order < stage.Order).OrderByDescending(s => s.Order).FirstOrDefault();
        if (above is null) return;

        // Optimistic swap
        var stageOrder = stage.Order;
        var aboveOrder = above.Order;
        stage.Order = aboveOrder;
        above.Order = stageOrder;
        _stages = _stages.OrderBy(s => s.Order).ToList();

        _errorBanner = null;
        try
        {
            var client = HttpClientFactory.CreateClient("AdminApi");
            var task1 = client.PutAsJsonAsync($"/api/pipeline-stages/{stage.Id}", new { stage.Name, stage.Order });
            var task2 = client.PutAsJsonAsync($"/api/pipeline-stages/{above.Id}", new { above.Name, above.Order });
            await Task.WhenAll(task1, task2);

            if (!task1.Result.IsSuccessStatusCode || !task2.Result.IsSuccessStatusCode)
            {
                // Revert on failure
                stage.Order = stageOrder;
                above.Order = aboveOrder;
                _stages = _stages.OrderBy(s => s.Order).ToList();
                _errorBanner = "Failed to reorder stages. Please try again.";
            }
            else
            {
                ShowSuccessMessage("Stages reordered.");
            }
        }
        catch (Exception ex)
        {
            // Revert on exception
            stage.Order = stageOrder;
            above.Order = aboveOrder;
            _stages = _stages.OrderBy(s => s.Order).ToList();
            _errorBanner = $"Failed to reorder stages: {ex.Message}";
        }
    }

    private async Task MoveStageDownAsync(Guid id)
    {
        var stage = _stages.FirstOrDefault(s => s.Id == id);
        if (stage is null) return;

        var below = _stages.Where(s => s.Order > stage.Order).OrderBy(s => s.Order).FirstOrDefault();
        if (below is null) return;

        // Optimistic swap
        var stageOrder = stage.Order;
        var belowOrder = below.Order;
        stage.Order = belowOrder;
        below.Order = stageOrder;
        _stages = _stages.OrderBy(s => s.Order).ToList();

        _errorBanner = null;
        try
        {
            var client = HttpClientFactory.CreateClient("AdminApi");
            var task1 = client.PutAsJsonAsync($"/api/pipeline-stages/{stage.Id}", new { stage.Name, stage.Order });
            var task2 = client.PutAsJsonAsync($"/api/pipeline-stages/{below.Id}", new { below.Name, below.Order });
            await Task.WhenAll(task1, task2);

            if (!task1.Result.IsSuccessStatusCode || !task2.Result.IsSuccessStatusCode)
            {
                // Revert on failure
                stage.Order = stageOrder;
                below.Order = belowOrder;
                _stages = _stages.OrderBy(s => s.Order).ToList();
                _errorBanner = "Failed to reorder stages. Please try again.";
            }
            else
            {
                ShowSuccessMessage("Stages reordered.");
            }
        }
        catch (Exception ex)
        {
            // Revert on exception
            stage.Order = stageOrder;
            below.Order = belowOrder;
            _stages = _stages.OrderBy(s => s.Order).ToList();
            _errorBanner = $"Failed to reorder stages: {ex.Message}";
        }
    }

