@page "/admin/configuration"
@attribute [Authorize]
@using IronMonkey.Web.HttpHandlers
@using IronMonkey.Web.Components.Pages.Admin.Workflow
@inject AdminApiClient Api
@inject NavigationManager Nav

@* Tenant configuration workspace.

   Each area is a self-contained component so this page stays a shell: tab state, the shared
   result banner, and the workflow rules that have not been reworked. The selected tab lives
   in the query string, so a refresh or a shared link opens the same area. *@

<PageTitle>@($"{ActiveTab.Title} — System Configuration")</PageTitle>

<div class="space-y-6">

    <div>
        <h1 class="text-2xl font-bold text-slate-900">System configuration</h1>
        <p class="mt-1 text-sm text-slate-600">
            Pipeline stages, custom fields, routing and automation for your organisation.
        </p>
    </div>

    <div class="border-b border-slate-200">
        <nav class="-mb-px flex gap-6 overflow-x-auto" aria-label="Configuration areas">
            @foreach (var tab in Tabs)
            {
                <a href="@($"/admin/configuration?tab={tab.Slug}")"
                   aria-current="@(tab.Slug == ActiveTab.Slug ? "page" : null)"
                   class="@(tab.Slug == ActiveTab.Slug
                        ? "border-b-2 border-indigo-600 text-indigo-600 font-medium"
                        : "border-b-2 border-transparent text-slate-600 hover:text-slate-900") whitespace-nowrap px-1 py-4 text-sm transition-colors">
                    @tab.Title
                </a>
            }
        </nav>
    </div>

    <p class="text-sm text-slate-600">@ActiveTab.Description</p>

    @if (!string.IsNullOrEmpty(_errorBanner))
    {
        <div role="alert" class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            @_errorBanner
        </div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div role="status" class="rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-700">
            @_successMessage
        </div>
    }

    @* Each branch renders a different component type, so switching tabs disposes the old
       one and builds the new — no draft state leaks between areas. *@
    @switch (ActiveTab.Slug)
    {
        case "stages":
            <PipelineStagesTab OnSuccess="ShowSuccess" OnError="ShowError" />
            break;

        case "fields":
            <CustomFieldsTab OnSuccess="ShowSuccess" OnError="ShowError" />
            break;

        case "routing":
            <RoutingTab OnSuccess="ShowSuccess" OnError="ShowError" />
            break;

        case "appearance":
            <AppearanceTab OnSuccess="ShowSuccess" OnError="ShowError" />
            break;

        case "workflows":
            <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-indigo-200 bg-indigo-50 px-4 py-3">
                <p class="text-sm text-indigo-900">
                    Rules automate your pipeline — notify someone, assign a lead, create a task,
                    call an external API or send an email.
                </p>
                <div class="flex shrink-0 flex-wrap gap-2">
                    <a href="/admin/workflow-runs"
                       class="rounded-lg border border-indigo-300 bg-white px-3 py-1.5 text-xs font-semibold text-indigo-700 hover:bg-indigo-50">
                        View run history
                    </a>
                    <a href="/admin/help/workflows"
                       class="rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-500">
                        How rules work &amp; examples
                    </a>
                </div>
            </div>

            @if (_isLoading)
            {
                <div class="py-12 text-center">
                    <p class="text-sm text-slate-500">Loading...</p>
                </div>
            }
            else if (_rules.Count == 0 && !_creatingRule)
            {
                <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 py-16 text-center">
                    <p class="text-slate-600">No workflow rules configured. Create rules to automate your lead pipeline.</p>
                    <button type="button" @onclick="StartAddRule"
                            class="mt-4 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">
                        + Add Rule
                    </button>
                </div>
            }
            else
            {
                <div class="overflow-x-auto rounded-lg border border-slate-200">
                    <table class="w-full">
                        <thead class="bg-slate-50 border-b border-slate-200">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Name</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Trigger</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-slate-900 uppercase tracking-wide">Recent runs</th>
                                <th class="px-6 py-3 text-center text-xs font-semibold text-slate-900 uppercase tracking-wide">Active</th>
                                <th class="px-6 py-3 text-right text-xs font-semibold text-slate-900 uppercase tracking-wide">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rule in _rules)
                            {
                                <tr @key="rule.Id" class="border-b border-slate-100 @(_editingRuleId == rule.Id ? "bg-indigo-50" : "hover:bg-slate-50")">
                                    <td class="px-6 py-4 text-sm font-medium text-slate-900">@rule.Name</td>
                                    <td class="px-6 py-4 text-sm text-slate-600">@rule.Trigger</td>
                                    <td class="px-6 py-4 text-sm">
                                        @* Absent summary data is left blank rather than shown as
                                           "0 runs", which would claim the rule never fired when in
                                           fact we did not load its history. *@
                                        @if (_runSummaries.TryGetValue(rule.Id, out var summary))
                                        {
                                            <a href="@($"/admin/workflow-runs?ruleId={rule.Id}")"
                                               class="text-indigo-600 hover:text-indigo-700 hover:underline">
                                                @summary.RecentRunCount in @_runWindowDays days
                                            </a>
                                            @if (summary.RecentFailureCount > 0)
                                            {
                                                <span class="ml-2 inline-flex rounded-full bg-red-100 px-2 py-0.5 text-xs font-semibold text-red-800">
                                                    @summary.RecentFailureCount failed
                                                </span>
                                            }
                                            @if (summary.LatestRunAt is { } latest)
                                            {
                                                <span class="mt-1 block text-xs text-slate-500">
                                                    Last: @LatestStatusLabel(summary.LatestStatus) @latest.ToString("dd MMM HH:mm")
                                                </span>
                                            }
                                        }
                                        else if (_runSummariesLoaded)
                                        {
                                            <span class="text-slate-400">No runs yet</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        <button type="button" @onclick="() => ToggleRuleActiveAsync(rule.Id)"
                                                title="@(rule.IsActive ? "Deactivate rule" : "Activate rule")"
                                                class="relative inline-flex h-6 w-11 items-center rounded-full transition-colors @(rule.IsActive ? "bg-indigo-600" : "bg-slate-300")">
                                            <span class="inline-block h-4 w-4 transform rounded-full bg-white transition-transform @(rule.IsActive ? "translate-x-6" : "translate-x-1")"></span>
                                        </button>
                                    </td>
                                    <td class="px-6 py-4 text-right space-x-2">
                                        <a href="@($"/admin/workflow-runs?ruleId={rule.Id}")"
                                           class="text-sm font-medium text-slate-600 hover:text-slate-900">View runs</a>
                                        <button type="button" @onclick="() => StartEditRule(rule)"
                                                class="text-sm font-medium text-indigo-600 hover:text-indigo-700">Edit</button>
                                        <button type="button" @onclick="() => OpenDeleteRuleConfirm(rule.Id)"
                                                class="text-sm font-medium text-red-600 hover:text-red-700">Delete</button>
                                    </td>
                                </tr>

                                @if (_editingRuleId == rule.Id && _editingRule != null)
                                {
                                    <tr class="bg-indigo-50 border-b border-slate-100">
                                        <td colspan="5" class="px-6 py-4">
                                            <div class="space-y-4 max-w-2xl">
                                                <div class="grid grid-cols-2 gap-4">
                                                    <div>
                                                        <label class="block text-xs font-semibold text-slate-900 uppercase tracking-wider mb-1">Name</label>
                                                        <input type="text" @bind="_editingRule!.Name"
                                                               class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600" />
                                                    </div>
                                                    <div>
                                                        <label class="block text-xs font-semibold text-slate-900 uppercase tracking-wider mb-1">Trigger</label>
                                                        <select @bind="_editingRule!.Trigger"
                                                                class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600">
                                                            <option value="FieldChange">Field Change</option>
                                                            <option value="StatusChange">Status Change</option>
                                                            <option value="TimeElapsed">Time Elapsed</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div>
                                                    <label class="block text-xs font-semibold text-slate-900 uppercase tracking-wider mb-1">Condition (JSON)</label>
                                                    <textarea @bind="_editingRule!.ConditionJson" rows="4"
                                                              placeholder="{}"
                                                              class="w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm text-slate-900 focus:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600"></textarea>
                                                </div>
                                                <div>
                                                    <label class="block text-xs font-semibold text-slate-900 uppercase tracking-wider mb-1">Action (JSON)</label>
                                                    <textarea @bind="_editingRule!.ActionJson" rows="4"
                                                              placeholder="{}"
                                                              class="w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm text-slate-900 focus:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600"></textarea>
                                                </div>
                                                <div class="flex gap-2 justify-end">
                                                    <button type="button" @onclick="CancelEditRule"
                                                            class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancel</button>
                                                    <button type="button" @onclick="SaveEditRuleAsync" disabled="@_isSaving"
                                                            class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 disabled:opacity-50">
                                                        @(_isSaving ? "Saving..." : "Save")
                                                    </button>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Add Rule inline section (below table) -->
                @if (_creatingRule)
                {
                    <div class="mt-4 rounded-lg border border-indigo-200 bg-indigo-50 px-6 py-4">
                        <div class="space-y-4 max-w-2xl">
                            <p class="text-sm font-semibold text-slate-900">New Workflow Rule</p>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-semibold text-slate-900 uppercase tracking-wider mb-1">Name</label>
                                    <input type="text" @bind="_newRuleName" placeholder="Rule name"
                                           class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600" />
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-slate-900 uppercase tracking-wider mb-1">Trigger</label>
                                    <select @bind="_newRuleTrigger"
                                            class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 focus:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600">
                                        <option value="FieldChange">Field Change</option>
                                        <option value="StatusChange">Status Change</option>
                                        <option value="TimeElapsed">Time Elapsed</option>
                                    </select>
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-900 uppercase tracking-wider mb-1">Condition (JSON)</label>
                                <textarea @bind="_newRuleConditionJson" rows="4"
                                          placeholder="{}"
                                          class="w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm text-slate-900 focus:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600"></textarea>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-900 uppercase tracking-wider mb-1">Action (JSON)</label>
                                <textarea @bind="_newRuleActionJson" rows="4"
                                          placeholder="{}"
                                          class="w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm text-slate-900 focus:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600"></textarea>
                            </div>
                            <div class="flex gap-2 justify-end">
                                <button type="button" @onclick="CancelAddRule"
                                        class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">Cancel</button>
                                <button type="button" @onclick="SaveNewRuleAsync" disabled="@_isSaving"
                                        class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 disabled:opacity-50">
                                    @(_isSaving ? "Saving..." : "Create")
                                </button>
                            </div>
                        </div>
                    </div>
                }

                <!-- Add Rule button (below table) -->
                <div class="mt-4">
                    <button type="button" @onclick="StartAddRule"
                            disabled="@(_creatingRule || _editingRuleId != null)"
                            class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 disabled:opacity-50">
                        + Add Rule
                    </button>
                </div>
            }
            break;
    }

</div>

<!-- Delete confirmation modal -->
@if (_showDeleteConfirm)
{
    <div class="fixed inset-0 z-50 bg-black/40 flex items-center justify-center p-4">
        <div class="bg-white rounded-lg shadow-lg max-w-sm w-full">
            <div class="px-6 py-4 border-b border-slate-200">
                <h3 class="text-lg font-semibold text-slate-900">@_deleteModalTitle</h3>
            </div>
            <div class="px-6 py-4">
                <p class="text-sm text-slate-600">@_deleteModalMessage</p>
            </div>
            <div class="px-6 py-4 border-t border-slate-200 flex gap-2 justify-end">
                <button type="button" @onclick="CancelDelete"
                        class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                    Cancel
                </button>
                <button type="button" @onclick="ConfirmDeleteAsync" disabled="@_isSaving"
                        class="rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700 disabled:opacity-50">
                    @(_isSaving ? "Deleting..." : "Delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private sealed record ConfigTab(string Slug, string Title, string Description);

    /// <summary>
    /// Tabs are addressed by a stable slug in the query string so a refresh or a shared link
    /// lands on the same area. The title is display-only and can change freely.
    /// </summary>
    private static readonly ConfigTab[] Tabs =
    [
        new("stages", "Pipeline stages",
            "The columns of your lead board, in order. Retire a stage without losing its leads."),
        new("fields", "Custom fields",
            "Extra fields captured on leads and contacts, with their types, options and defaults."),
        new("routing", "Routing",
            "How a newly captured lead is given an owner."),
        new("workflows", "Workflow rules",
            "Automatic actions that run when a lead changes."),
        new("appearance", "Appearance",
            "What you call things, how money and dates are shown, and your branding."),
    ];

    [SupplyParameterFromQuery(Name = "tab")]
    private string? TabSlug { get; set; }

    /// <summary>Falls back to the first tab for a missing or unrecognised slug.</summary>
    private ConfigTab ActiveTab =>
        Tabs.FirstOrDefault(t => t.Slug == TabSlug) ?? Tabs[0];

    private string? _errorBanner;
    private string? _successMessage;

    private void ShowSuccess(string message)
    {
        _successMessage = message;
        _errorBanner = null;
    }

    private void ShowError(string message)
    {
        _errorBanner = message;
        _successMessage = null;
    }

    private void ShowSuccessMessage(string message) => ShowSuccess(message);

    // ── Workflow rules ───────────────────────────────────────────────────────
    //
    // Carried over unchanged from the previous single-file page. Kept here rather than
    // extracted into a component because this area was not part of the configuration rework.

    private bool _isLoading;
    private bool _isSaving;

    private List<RuleItem> _rules = new();
    private bool _rulesLoaded = false;

    // Recent-run counts per rule, keyed by rule id. Loaded separately from the rules
    // themselves so history being unavailable leaves the rules editable rather than
    // blanking the tab.
    private Dictionary<Guid, WorkflowRuleRunSummary> _runSummaries = new();
    private bool _runSummariesLoaded;
    private int _runWindowDays = 7;
    private Guid? _editingRuleId = null;
    private RuleItem? _editingRule = null;
    private bool _creatingRule = false;
    private string _newRuleName = string.Empty;
    private string _newRuleTrigger = "FieldChange";
    private string _newRuleConditionJson = "{}";
    private string _newRuleActionJson = "{}";

    private bool _showDeleteConfirm = false;
    private string _deleteModalTitle = string.Empty;
    private string _deleteModalMessage = string.Empty;
    private Guid _deletingItemId = Guid.Empty;

    private class RuleItem
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Trigger { get; set; } = "FieldChange";
        public string ConditionJson { get; set; } = "{}";
        public string ActionJson { get; set; } = "{}";
        public bool IsActive { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Rules load lazily: the other tabs fetch their own data, and this one is often not
        // the tab being opened.
        if (ActiveTab.Slug == "workflows" && !_rulesLoaded)
            await LoadRulesAsync();
    }

    private void CancelDelete()
    {
        _showDeleteConfirm = false;
        _deletingItemId = Guid.Empty;
    }

    private async Task ConfirmDeleteAsync()
    {
        var id = _deletingItemId;
        _showDeleteConfirm = false;
        _deletingItemId = Guid.Empty;

        if (id != Guid.Empty) await DeleteRuleAsync(id);
    }

    // ── Workflow Rules ───────────────────────────────────────────────────────

    private async Task LoadRulesAsync()
    {
        _isLoading = true;
        _errorBanner = null;
        try
        {
            var rules = await Api.GetFromJsonAsync<List<RuleItem>>("/api/workflow-rules");
            _rules = rules ?? new();
            _rulesLoaded = true;

            await LoadRunSummariesAsync();
        }
        catch (Exception ex)
        {
            _errorBanner = $"Failed to load workflow rules: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void StartAddRule()
    {
        _creatingRule = true;
        _editingRuleId = null;
        _newRuleName = string.Empty;
        _newRuleTrigger = "FieldChange";
        _newRuleConditionJson = "{}";
        _newRuleActionJson = "{}";
    }

    private void CancelAddRule()
    {
        _creatingRule = false;
        _newRuleName = string.Empty;
        _newRuleConditionJson = "{}";
        _newRuleActionJson = "{}";
    }

    private async Task SaveNewRuleAsync()
    {
        if (string.IsNullOrWhiteSpace(_newRuleName)) return;

        _isSaving = true;
        _errorBanner = null;
        try
        {
            var response = await Api.PostAsJsonAsync("/api/workflow-rules", new
            {
                Name = _newRuleName,
                Trigger = _newRuleTrigger,
                ConditionJson = _newRuleConditionJson,
                ActionJson = _newRuleActionJson
            });

            if (response.IsSuccessStatusCode)
            {
                var created = await response.Content.ReadFromJsonAsync<RuleItem>();
                if (created is not null)
                {
                    _rules.Add(created);
                }
                CancelAddRule();
                ShowSuccessMessage("Workflow rule created.");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _errorBanner = $"Failed to create workflow rule. {error}";
            }
        }
        catch (Exception ex)
        {
            _errorBanner = $"Failed to create workflow rule: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void StartEditRule(RuleItem r)
    {
        _editingRuleId = r.Id;
        _editingRule = new RuleItem
        {
            Id = r.Id,
            Name = r.Name,
            Trigger = r.Trigger,
            ConditionJson = r.ConditionJson,
            ActionJson = r.ActionJson,
            IsActive = r.IsActive
        };
        _creatingRule = false;
    }

    private void CancelEditRule()
    {
        _editingRuleId = null;
        _editingRule = null;
    }

    private async Task SaveEditRuleAsync()
    {
        if (_editingRule is null || _editingRuleId is null) return;
        if (string.IsNullOrWhiteSpace(_editingRule.Name)) return;

        _isSaving = true;
        _errorBanner = null;
        try
        {
            var response = await Api.PutAsJsonAsync($"/api/workflow-rules/{_editingRuleId}", new
            {
                Name = _editingRule.Name,
                Trigger = _editingRule.Trigger,
                ConditionJson = _editingRule.ConditionJson,
                ActionJson = _editingRule.ActionJson
            });

            if (response.IsSuccessStatusCode)
            {
                var updated = await response.Content.ReadFromJsonAsync<RuleItem>();
                if (updated is not null)
                {
                    var idx = _rules.FindIndex(r => r.Id == updated.Id);
                    if (idx >= 0) _rules[idx] = updated;
                }
                CancelEditRule();
                ShowSuccessMessage("Workflow rule saved.");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _errorBanner = $"Failed to save workflow rule. {error}";
            }
        }
        catch (Exception ex)
        {
            _errorBanner = $"Failed to save workflow rule: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ToggleRuleActiveAsync(Guid id)
    {
        _errorBanner = null;
        try
        {
            var response = await Api.PostAsync($"/api/workflow-rules/{id}/toggle",
                new StringContent(string.Empty, System.Text.Encoding.UTF8, "application/json"));

            if (response.IsSuccessStatusCode)
            {
                var rule = _rules.FirstOrDefault(r => r.Id == id);
                if (rule is not null)
                {
                    rule.IsActive = !rule.IsActive;
                    ShowSuccessMessage($"Rule is now {(rule.IsActive ? "active" : "inactive")}.");
                }
                StateHasChanged();
            }
            else
            {
                _errorBanner = "Failed to toggle rule status. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _errorBanner = $"Failed to toggle rule status: {ex.Message}";
        }
    }

    private void OpenDeleteRuleConfirm(Guid id)
    {
        _showDeleteConfirm = true;
        _deleteModalTitle = "Delete Workflow Rule";
        _deleteModalMessage = "Are you sure? This rule will no longer execute.";
        _deletingItemId = id;
    }

    private async Task DeleteRuleAsync(Guid id)
    {
        _isSaving = true;
        _errorBanner = null;
        try
        {
            var response = await Api.DeleteAsync($"/api/workflow-rules/{id}");

            if (response.IsSuccessStatusCode)
            {
                _rules.RemoveAll(r => r.Id == id);
                ShowSuccessMessage("Workflow rule deleted.");
            }
            else
            {
                _errorBanner = "Failed to delete workflow rule. Please try again.";
            }
        }
        catch (Exception ex)
        {
            _errorBanner = $"Failed to delete workflow rule: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    /// <summary>
    /// Fetches recent-run counts for the rules list.
    ///
    /// Failure here is deliberately silent: the counts are a convenience on a page whose job
    /// is editing rules, and a user without workflow:logs:read gets a 403 that must not read
    /// as "the rules failed to load". The column simply stays blank.
    /// </summary>
    private async Task LoadRunSummariesAsync()
    {
        try
        {
            var summary = await Api.GetFromJsonAsync<WorkflowRunSummaryResponse>("/api/workflow-rules/run-summary");
            if (summary is null) return;

            _runSummaries = summary.Rules.ToDictionary(r => r.WorkflowRuleId);
            _runWindowDays = summary.WindowDays;
            _runSummariesLoaded = true;
        }
        catch
        {
            // Counts are optional; the rules themselves are already on screen.
        }
    }

    private static string LatestStatusLabel(string? status) => status switch
    {
        "PartiallySucceeded" => "partly succeeded",
        null or "" => "—",
        _ => status.ToLowerInvariant()
    };
}
