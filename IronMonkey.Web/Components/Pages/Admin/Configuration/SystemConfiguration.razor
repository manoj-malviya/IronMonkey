    private static List<string> ParseOptions(string raw) =>
        string.IsNullOrWhiteSpace(raw)
            ? new List<string>()
            : raw.Split(',').Select(s => s.Trim()).Where(s => !string.IsNullOrEmpty(s)).ToList();

    // ── Routing ──────────────────────────────────────────────────────────────

    private bool _routingLoaded = false;
    private string _routingMode = "RoundRobin";
    private string _territoryJson = string.Empty;

    private async Task LoadRoutingConfigAsync()
    {
        _isLoading = true;
        _errorBanner = null;
        try
        {
            var client = HttpClientFactory.CreateClient("AdminApi");
            var response = await client.GetAsync("/api/routing-config");

            if (response.IsSuccessStatusCode)
            {
                var config = await response.Content.ReadFromJsonAsync<RoutingConfigResponse>();
                if (config is not null)
                {
                    _routingMode = config.Strategy ?? "RoundRobin";
                    _territoryJson = config.TerritoryMapJson ?? string.Empty;
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                // No config yet — use defaults
                _routingMode = "RoundRobin";
                _territoryJson = string.Empty;
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _errorBanner = $"Failed to load routing configuration. {error}";
            }
            _routingLoaded = true;
        }
        catch (Exception ex)
        {
            _errorBanner = $"Failed to load routing configuration: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SaveRoutingConfigAsync()
    {
        _isSaving = true;
        _errorBanner = null;
        try
        {
            var client = HttpClientFactory.CreateClient("AdminApi");
            var response = await client.PostAsJsonAsync("/api/routing-config", new
            {
                Strategy = _routingMode,
                Dimension = "Agent", // default dimension — required by endpoint
                TerritoryMapJson = _routingMode == "Territory" ? _territoryJson : (string?)null,
                CustomFieldKey = (string?)null
            });

            if (response.IsSuccessStatusCode)
            {
                ShowSuccessMessage("Routing configuration saved.");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _errorBanner = $"Failed to save routing configuration. {error}";
            }
        }
        catch (Exception ex)
        {
            _errorBanner = $"Failed to save routing configuration: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    // DTO for reading routing config response
    private record RoutingConfigResponse(Guid Id, string Strategy, string Dimension,
        string? TerritoryMapJson, string? CustomFieldKey, bool IsEnabled, int RoundRobinPointer);
