@using IronMonkey.Web.HttpHandlers
@inject AdminApiClient Api

@* Deal stages — the opportunity pipeline's columns.

   Part A built the six /api/opportunity-stages endpoints and no UI at all, so a tenant could
   not manage deal stages from the product. This is that UI.

   It deliberately mirrors PipelineStagesTab rule for rule rather than inventing a second
   interaction: the two edit the same entity with a different RecordType, and a divergent
   second stage editor is exactly the failure mode the whole feature set is avoiding. The two
   real differences are the stage TYPE editor (won/lost is decided by the type, never by the
   name, so an Admin has to be able to set it) and the pipeline picker.

   The pipeline picker renders ONLY when the tenant has more than one deal pipeline. A tenant
   with one is never shown it and never makes a choice — that is the single-pipeline
   guarantee, implemented here rather than merely asserted. *@

<div class="space-y-4">

    <div class="flex flex-wrap items-center justify-between gap-3">
        @* Only rendered for a genuinely multi-pipeline tenant. *@
        @if (_isMultiPipeline)
        {
            <div class="flex items-center gap-2">
                <label for="deal-pipeline" class="text-sm font-medium text-slate-700">Pipeline</label>
                <select id="deal-pipeline" value="@_selectedPipelineId"
                        @onchange="OnPipelineChangedAsync"
                        class="rounded-lg border border-slate-300 px-3 py-2 text-sm">
                    @foreach (var pipeline in _pipelines)
                    {
                        <option value="@pipeline.Id">
                            @pipeline.Name@(pipeline.IsDefault ? " (default)" : "")
                        </option>
                    }
                </select>
                <span class="text-xs text-slate-500">
                    Each pipeline has its own stages and its own order.
                </span>
            </div>
        }
        else
        {
            <div></div>
        }

        <button type="button" @onclick="StartAdd"
                class="shrink-0 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700">
            Add stage
        </button>
    </div>

    @if (_loading)
    {
        <p class="py-12 text-center text-sm text-slate-500">Loading deal stages…</p>
    }
    else if (_stages.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 py-16 text-center">
            <p class="text-slate-600">No deal stages yet. Add your first stage to start tracking opportunities.</p>
        </div>
    }
    else
    {
        <div class="flex flex-wrap items-center gap-3" role="status" aria-live="polite">
            @switch (_orderState)
            {
                case SaveState.Unsaved:
                    <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">
                        Unsaved order changes
                    </span>
                    <button type="button" @onclick="SaveOrderAsync"
                            class="rounded-lg bg-indigo-600 px-4 py-1.5 text-xs font-semibold text-white hover:bg-indigo-700">
                        Save order
                    </button>
                    <button type="button" @onclick="DiscardOrder"
                            class="rounded-lg border border-slate-300 px-4 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50">
                        Discard
                    </button>
                    break;

                case SaveState.Saving:
                    <span class="text-xs font-semibold text-slate-600">Saving order…</span>
                    break;

                case SaveState.Saved:
                    <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-800">
                        Order saved
                    </span>
                    break;

                case SaveState.Error:
                    <span class="rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-800">
                        @(_orderError ?? "Order could not be saved")
                    </span>
                    break;
            }
        </div>

        <ul class="divide-y divide-slate-200 overflow-hidden rounded-xl border border-slate-200 bg-white">
            @foreach (var (stage, index) in _stages.Select((s, i) => (s, i)))
            {
                <li @key="stage.Id" class="flex flex-wrap items-center gap-x-3 gap-y-2 px-4 py-3">
                    <span class="w-6 shrink-0 text-sm tabular-nums text-slate-400">@(index + 1)</span>

                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium text-slate-900">@stage.Name</p>
                        <div class="mt-0.5 flex flex-wrap items-center gap-1.5">
                            @* The type is shown on every row because it, not the name, is what
                               decides whether a deal counts as won. A stage called "Closed"
                               that is typed Active is a real and confusing configuration, and
                               it should be visible at a glance. *@
                            <span class="@StageTypeBadgeClass(stage.StageType) inline-block rounded-full px-2 py-0.5 text-xs font-medium">
                                @StageTypeLabel(stage.StageType)
                            </span>
                            @if (!stage.IsActive)
                            {
                                <span class="inline-block rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">
                                    Inactive
                                </span>
                            }
                        </div>
                    </div>

                    <div class="flex shrink-0 basis-full items-center justify-end gap-1 sm:basis-auto">
                        <button type="button" @onclick="() => MoveUp(index)" disabled="@(index == 0)"
                                aria-label="@($"Move {stage.Name} up")"
                                class="rounded-lg border border-slate-300 px-2.5 py-1.5 text-sm text-slate-700 hover:bg-slate-50 disabled:opacity-30">
                            ↑
                        </button>
                        <button type="button" @onclick="() => MoveDown(index)" disabled="@(index == _stages.Count - 1)"
                                aria-label="@($"Move {stage.Name} down")"
                                class="rounded-lg border border-slate-300 px-2.5 py-1.5 text-sm text-slate-700 hover:bg-slate-50 disabled:opacity-30">
                            ↓
                        </button>
                        <button type="button" @onclick="() => StartEdit(stage)"
                                aria-label="@($"Edit {stage.Name}")"
                                class="rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
                            Edit
                        </button>
                        <button type="button" @onclick="() => OpenRemoveAsync(stage)"
                                aria-label="@($"Remove {stage.Name}")"
                                class="rounded-lg border border-red-200 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50">
                            Remove
                        </button>
                    </div>
                </li>
            }
        </ul>

        @if (!_stages.Any(s => s.StageType == "ClosedWon") || !_stages.Any(s => s.StageType == "ClosedLost"))
        {
            @* A pipeline with no won or no lost stage cannot close a deal at all, and the
               failure would otherwise only surface when someone tried. *@
            <p class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
                This pipeline has no
                @(!_stages.Any(s => s.StageType == "ClosedWon") ? "“Closed won”" : "")@(!_stages.Any(s => s.StageType == "ClosedWon") && !_stages.Any(s => s.StageType == "ClosedLost") ? " or " : "")@(!_stages.Any(s => s.StageType == "ClosedLost") ? "“Closed lost”" : "")
                stage, so deals in it cannot be closed. Add one, or change an existing stage's outcome.
            </p>
        }
    }
</div>

@* ── Edit / create panel ────────────────────────────────────────────────────── *@
@if (_panelOpen)
{
    <div class="fixed inset-0 z-40 bg-slate-900/30" @onclick="ClosePanel"></div>

    <aside role="dialog" aria-modal="true" aria-label="@(_editing is null ? "Add deal stage" : "Edit deal stage")"
           class="fixed inset-y-0 right-0 z-50 flex w-full max-w-md flex-col bg-white shadow-xl">

        <header class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
            <h2 class="text-lg font-semibold text-slate-900">
                @(_editing is null ? "Add deal stage" : "Edit deal stage")
            </h2>
            <button type="button" @onclick="ClosePanel" aria-label="Close"
                    class="rounded-lg p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-600">✕</button>
        </header>

        <div class="flex-1 space-y-5 overflow-y-auto px-6 py-5">
            @if (_panelError is not null)
            {
                <p class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">@_panelError</p>
            }

            <div>
                <label for="deal-stage-name" class="mb-1 block text-sm font-medium text-slate-700">Stage name</label>
                <input id="deal-stage-name" @bind="_draftName" @bind:event="oninput" maxlength="100"
                       class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                <p class="mt-1 text-xs text-slate-500">Shown as a column heading on the deal board.</p>
            </div>

            <div>
                <label for="deal-stage-type" class="mb-1 block text-sm font-medium text-slate-700">Outcome</label>
                <select id="deal-stage-type" @bind="_draftStageType"
                        class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
                    <option value="Entry">First stage — where new deals start</option>
                    <option value="Active">In progress</option>
                    <option value="ClosedWon">Closed won</option>
                    <option value="ClosedLost">Closed lost</option>
                </select>
                @* The one thing an Admin most needs to understand here: the product reads the
                   outcome, never the name. Renaming "Lost" to "Declined" must not break
                   closing, reporting or the dashboard, and this is why it does not. *@
                <p class="mt-1 text-xs text-slate-500">
                    Reporting and the dashboard read this, not the stage's name — so you can
                    rename “Won” to anything you like and your won figures stay correct.
                </p>
            </div>

            @if (_editing is not null)
            {
                <div>
                    <label class="flex items-center gap-2 text-sm text-slate-700">
                        <input type="checkbox" checked="@_draftActive"
                               @onchange="e => _draftActive = (bool)(e.Value ?? false)"
                               class="rounded border-slate-300" />
                        <span>Active</span>
                    </label>
                    <p class="mt-1 text-xs text-slate-500">
                        Inactive stages stay on existing deals but are not offered for new ones.
                    </p>
                </div>
            }
        </div>

        <footer class="flex justify-end gap-2 border-t border-slate-200 px-6 py-4">
            <button type="button" @onclick="ClosePanel"
                    class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                Cancel
            </button>
            <button type="button" @onclick="SavePanelAsync" disabled="@_panelSaving"
                    class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-700 disabled:opacity-50">
                @(_panelSaving ? "Saving…" : "Save")
            </button>
        </footer>
    </aside>
}

@* ── Remove confirmation, with impact ───────────────────────────────────────── *@
@if (_removing is not null)
{
    <div class="fixed inset-0 z-40 bg-slate-900/40" @onclick="CancelRemove"></div>

    <div role="dialog" aria-modal="true" aria-labelledby="remove-deal-stage-title"
         class="fixed left-1/2 top-1/2 z-50 w-[min(32rem,calc(100vw-2rem))] -translate-x-1/2 -translate-y-1/2 rounded-xl bg-white p-6 shadow-xl">

        <h2 id="remove-deal-stage-title" class="text-lg font-semibold text-slate-900">
            Remove “@_removing.Name”?
        </h2>

        @if (_impact is null)
        {
            <p class="mt-3 text-sm text-slate-600">Checking what this affects…</p>
        }
        else
        {
            <div class="mt-3 space-y-3 text-sm text-slate-600">
                @if (_impact.IsOnlyActiveStage)
                {
                    <p class="rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-red-700">
                        This is the only active stage in this pipeline. A pipeline needs at least
                        one active stage to accept deals, so it cannot be removed.
                    </p>
                }
                else
                {
                    <p>
                        This stage holds
                        <strong>@_impact.OpportunityCount deal@(_impact.OpportunityCount == 1 ? "" : "s")</strong>@(_impact.HistoryCount > 0
                            ? $" and appears in {_impact.HistoryCount} history record{(_impact.HistoryCount == 1 ? "" : "s")}"
                            : "").
                    </p>

                    @if (_impact.OpportunityCount > 0)
                    {
                        <div>
                            <label for="deal-reassign" class="mb-1 block text-sm font-medium text-slate-700">
                                Move those deals to
                            </label>
                            @* Every option here comes from the same pipeline — the API only
                               offers targets from the stage's own pipeline, so a deal can
                               never be reassigned into a funnel it was not in. *@
                            <select id="deal-reassign" @bind="_reassignTo"
                                    class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
                                <option value="">— Choose a stage —</option>
                                @foreach (var target in _impact.ReassignTargets)
                                {
                                    <option value="@target.Id">@target.Name</option>
                                }
                            </select>
                        </div>
                    }

                    <p class="text-slate-500">
                        The stage is deactivated rather than deleted, so history that refers to it
                        stays readable.
                    </p>
                }
            </div>
        }

        @if (_removeError is not null)
        {
            <p class="mt-3 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">@_removeError</p>
        }

        <div class="mt-5 flex justify-end gap-2">
            <button type="button" @onclick="CancelRemove"
                    class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
                Cancel
            </button>
            <button type="button" @onclick="ConfirmRemoveAsync"
                    disabled="@(_removeBusy || _impact is null || _impact.IsOnlyActiveStage
                                || (_impact.OpportunityCount > 0 && string.IsNullOrEmpty(_reassignTo)))"
                    class="rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700 disabled:opacity-50">
                @(_removeBusy ? "Removing…" : "Remove stage")
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback<string> OnSuccess { get; set; }

    [Parameter] public EventCallback<string> OnError { get; set; }

    private List<StageItem> _stages = [];
    private List<StageItem> _savedOrder = [];

    private List<PipelineItem> _pipelines = [];
    private bool _isMultiPipeline;

    /// <summary>
    /// The pipeline being edited. Null until the first load resolves it — for a
    /// single-pipeline tenant that is simply the only pipeline, chosen with no user input.
    /// </summary>
    private Guid? _selectedPipelineId;

    private bool _loading = true;

    private SaveState _orderState = SaveState.Idle;
    private string? _orderError;

    private bool _panelOpen;
    private StageItem? _editing;
    private string _draftName = string.Empty;
    private string _draftStageType = "Active";
    private bool _draftActive = true;
    private bool _panelSaving;
    private string? _panelError;

    private StageItem? _removing;
    private OpportunityStageImpact? _impact;
    private string _reassignTo = string.Empty;
    private bool _removeBusy;
    private string? _removeError;

    /// <summary>
    /// Fetched after the first interactive render rather than in OnInitializedAsync.
    ///
    /// The JWT lives in ProtectedSessionStorage, which is unreadable during prerender, so a
    /// call made there goes out unauthenticated and 401s silently. Every request below also
    /// goes through AdminApiClient rather than IHttpClientFactory, because BearerTokenHandler
    /// runs in the factory's own DI scope and cannot see this circuit's auth provider.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var pipelines = await Api.GetFromJsonAsync<PipelineListResponse>(
                "/api/pipelines?recordType=Opportunity");

            _pipelines = pipelines?.Items ?? [];
            _isMultiPipeline = pipelines?.IsMultiPipeline ?? false;

            // Keep the current selection across a reload if it still exists; otherwise fall
            // back to the default. A selection silently jumping to another pipeline after an
            // edit would show the Admin a different funnel than the one they were editing.
            if (_selectedPipelineId is null || _pipelines.All(p => p.Id != _selectedPipelineId))
                _selectedPipelineId = pipelines?.DefaultPipelineId ?? _pipelines.FirstOrDefault()?.Id;

            await LoadStagesAsync();
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync($"Failed to load deal stages: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadStagesAsync()
    {
        // includeInactive=true because this is the configuration screen: an Admin has to be
        // able to see and reactivate a retired stage. Every board and picker leaves it off.
        var url = "/api/opportunity-stages?includeInactive=true";
        if (_selectedPipelineId is { } pipelineId) url += $"&pipelineId={pipelineId}";

        var stages = await Api.GetFromJsonAsync<List<StageItem>>(url) ?? [];

        _stages = [.. stages.OrderBy(s => s.Order)];
        _savedOrder = [.. _stages];
        _orderState = SaveState.Idle;
    }

    private async Task OnPipelineChangedAsync(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var pipelineId)) return;

        _selectedPipelineId = pipelineId;

        // Any staged reorder belonged to the pipeline being left, so it is dropped rather
        // than carried over and applied to a different pipeline's stages.
        _orderState = SaveState.Idle;
        _orderError = null;

        _loading = true;
        try
        {
            await LoadStagesAsync();
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync($"Failed to load deal stages: {ex.Message}");
        }
        finally
        {
            _loading = false;
        }
    }

    // ── Ordering ────────────────────────────────────────────────────────────

    private void MoveUp(int index)
    {
        if (index <= 0) return;
        (_stages[index - 1], _stages[index]) = (_stages[index], _stages[index - 1]);
        _orderState = SaveState.Unsaved;
    }

    private void MoveDown(int index)
    {
        if (index >= _stages.Count - 1) return;
        (_stages[index + 1], _stages[index]) = (_stages[index], _stages[index + 1]);
        _orderState = SaveState.Unsaved;
    }

    /// <summary>
    /// Sends the COMPLETE sequence for this pipeline in one request. The endpoint rewrites it
    /// in a single transaction and 409s if the submitted set differs from the stored one —
    /// which is the concurrency check, and is why a partial list must never be sent.
    /// </summary>
    private async Task SaveOrderAsync()
    {
        _orderState = SaveState.Saving;
        _orderError = null;

        try
        {
            var response = await Api.PutAsJsonAsync("/api/opportunity-stages/order",
                new { StageIds = _stages.Select(s => s.Id).ToList(), PipelineId = _selectedPipelineId });

            if (response.IsSuccessStatusCode)
            {
                var updated = await response.Content.ReadFromJsonAsync<List<StageItem>>() ?? [];
                _stages = [.. updated.OrderBy(s => s.Order)];
                _savedOrder = [.. _stages];
                _orderState = SaveState.Saved;
            }
            else
            {
                _orderError = await ReadProblemAsync(response);
                _orderState = SaveState.Error;

                // A conflict means someone else changed the stage list. Reload rather than
                // leave a stale order on screen that would only fail again.
                if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
                    await LoadStagesAsync();
            }
        }
        catch (Exception ex)
        {
            _orderError = ex.Message;
            _orderState = SaveState.Error;
        }
    }

    private void DiscardOrder()
    {
        _stages = [.. _savedOrder];
        _orderState = SaveState.Idle;
    }

    // ── Create / edit ───────────────────────────────────────────────────────

    private void StartAdd()
    {
        _editing = null;
        _draftName = string.Empty;
        _draftStageType = "Active";
        _draftActive = true;
        _panelError = null;
        _panelOpen = true;
    }

    private void StartEdit(StageItem stage)
    {
        _editing = stage;
        _draftName = stage.Name;
        _draftStageType = stage.StageType;
        _draftActive = stage.IsActive;
        _panelError = null;
        _panelOpen = true;
    }

    private void ClosePanel()
    {
        _panelOpen = false;
        _editing = null;
        _panelError = null;
    }

    private async Task SavePanelAsync()
    {
        var name = _draftName.Trim();

        if (string.IsNullOrWhiteSpace(name))
        {
            _panelError = "Enter a stage name.";
            return;
        }

        // Checked against THIS pipeline's stages only, matching the server's own per-pipeline
        // uniqueness rule — another pipeline may legitimately have a stage of the same name.
        var clash = _stages.Any(s =>
            (_editing is null || s.Id != _editing.Id)
            && string.Equals(s.Name, name, StringComparison.OrdinalIgnoreCase));

        if (clash)
        {
            _panelError = $"A stage named '{name}' already exists in this pipeline.";
            return;
        }

        _panelSaving = true;
        _panelError = null;

        try
        {
            HttpResponseMessage response;

            if (_editing is null)
            {
                response = await Api.PostAsJsonAsync("/api/opportunity-stages",
                    new { Name = name, StageType = _draftStageType, PipelineId = _selectedPipelineId });
            }
            else
            {
                response = await Api.PutAsJsonAsync($"/api/opportunity-stages/{_editing.Id}",
                    new { Name = name, StageType = _draftStageType, IsActive = _draftActive });
            }

            if (response.IsSuccessStatusCode)
            {
                var verb = _editing is null ? "created" : "updated";
                ClosePanel();
                await LoadStagesAsync();
                await OnSuccess.InvokeAsync($"Deal stage '{name}' {verb}.");
            }
            else
            {
                _panelError = await ReadProblemAsync(response);
            }
        }
        catch (Exception ex)
        {
            _panelError = ex.Message;
        }
        finally
        {
            _panelSaving = false;
        }
    }

    // ── Remove ──────────────────────────────────────────────────────────────

    /// <summary>
    /// Asks the impact endpoint what removing this stage would affect BEFORE offering the
    /// button. Nothing referenced is removed silently — the dialog states the consequence
    /// rather than asking "are you sure?" about an unknown number of deals.
    /// </summary>
    private async Task OpenRemoveAsync(StageItem stage)
    {
        _removing = stage;
        _impact = null;
        _reassignTo = string.Empty;
        _removeError = null;

        try
        {
            _impact = await Api.GetFromJsonAsync<OpportunityStageImpact>(
                $"/api/opportunity-stages/{stage.Id}/impact");

            if (_impact is null)
                _removeError = "Could not check what this stage affects. Try again.";
        }
        catch (Exception ex)
        {
            _removeError = ex.Message;
        }
    }

    private void CancelRemove()
    {
        _removing = null;
        _impact = null;
        _removeError = null;
    }

    private async Task ConfirmRemoveAsync()
    {
        if (_removing is null) return;

        _removeBusy = true;
        _removeError = null;

        try
        {
            var url = $"/api/opportunity-stages/{_removing.Id}";
            if (!string.IsNullOrEmpty(_reassignTo)) url += $"?reassignTo={_reassignTo}";

            var response = await Api.DeleteAsync(url);

            if (response.IsSuccessStatusCode)
            {
                var name = _removing.Name;
                CancelRemove();
                await LoadStagesAsync();
                await OnSuccess.InvokeAsync($"Deal stage '{name}' removed.");
            }
            else
            {
                _removeError = await ReadProblemAsync(response);
            }
        }
        catch (Exception ex)
        {
            _removeError = ex.Message;
        }
        finally
        {
            _removeBusy = false;
        }
    }

    // ── Presentation ────────────────────────────────────────────────────────

    private static string StageTypeLabel(string stageType) => stageType switch
    {
        "Entry" => "First stage",
        "ClosedWon" => "Closed won",
        "ClosedLost" => "Closed lost",
        _ => "In progress"
    };

    private static string StageTypeBadgeClass(string stageType) => stageType switch
    {
        "Entry" => "bg-blue-100 text-blue-800",
        "ClosedWon" => "bg-green-100 text-green-800",
        "ClosedLost" => "bg-red-100 text-red-800",
        _ => "bg-slate-100 text-slate-700"
    };

    /// <summary>
    /// Endpoints return a bare JSON string for conflicts and bad requests. Unwrap it so the
    /// user sees the sentence, not a quoted blob.
    /// </summary>
    private static async Task<string> ReadProblemAsync(HttpResponseMessage response)
    {
        var body = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(body)) return $"Request failed ({(int)response.StatusCode}).";

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.String)
                return doc.RootElement.GetString() ?? body;
        }
        catch (System.Text.Json.JsonException)
        {
            // Not JSON — show it as-is.
        }

        return body;
    }
}
