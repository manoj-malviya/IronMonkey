@page "/admin/reports/revenue"
@attribute [Authorize]
@inject IronMonkey.Web.HttpHandlers.AdminApiClient Api
@inject TenantPresentationService Presentation

<PageTitle>Revenue — IronMonkey</PageTitle>

<div class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Revenue</h1>
            <p class="text-sm text-slate-500">From deal line items, by close date. @_report?.ScopeLabel</p>
        </div>
        <select @bind="_preset" @bind:after="LoadAsync" aria-label="Date range"
                class="rounded-lg border border-slate-300 px-3 py-2 text-sm">
            <option value="thismonth">This month</option>
            <option value="thisquarter">This quarter</option>
            <option value="thisyear">This year</option>
            <option value="last30days">Last 30 days</option>
            <option value="alltime">All time</option>
        </select>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">@_error</div>
    }

    @if (_report is null)
    {
        <p class="text-sm text-slate-500">Loading…</p>
    }
    else
    {
        @if (_report.UnconvertedDealCount > 0)
        {
            <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="status">
                @_report.UnconvertedDealCount deal@(_report.UnconvertedDealCount == 1 ? " is" : "s are") in another currency with no recorded
                exchange rate and @(_report.UnconvertedDealCount == 1 ? "is" : "are") <strong>not included</strong> below:
                @string.Join(", ", _report.Unconverted.Select(kv => Presentation.MoneyExact(kv.Value, kv.Key)))
                — record a rate on @(_report.UnconvertedDealCount == 1 ? "that deal" : "those deals") to include @(_report.UnconvertedDealCount == 1 ? "it" : "them").
            </div>
        }

        <div class="grid gap-4 sm:grid-cols-4">
            <Tile Label="Won revenue" Value="@M(_report.WonRevenue)" Sub="@Deals(_report.WonDealCount)" />
            <Tile Label="One-off" Value="@M(_report.WonOneOffRevenue)" Sub="won" />
            <Tile Label="Recurring (contract)" Value="@M(_report.WonRecurringRevenue)" Sub="won" />
            <Tile Label="Open pipeline" Value="@M(_report.OpenPipelineValue)" Sub="@($"{Deals(_report.OpenDealCount)} · {M(_report.OpenRecurringValue)} recurring")" />
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-5">
            <h2 class="mb-1 text-sm font-semibold text-slate-900">Discounting</h2>
            <p class="text-sm text-slate-600">
                Won deals were listed at @M(_report.WonListValue) and discounted by @M(_report.WonDiscount)
                (@_report.WonDiscountRatePercent.ToString("0.#")%).
            </p>
        </div>

        <div class="rounded-xl border border-slate-200 bg-white">
            <h2 class="border-b border-slate-200 px-5 py-3 text-sm font-semibold text-slate-900">By product</h2>
            @if (_report.ByProduct.Count == 0)
            {
                <p class="px-5 py-4 text-sm text-slate-500">No closed deals with line items in this range.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="min-w-full text-sm">
                        <thead>
                            <tr class="text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                                <th class="px-5 py-2">Product</th><th class="px-2">Category</th>
                                <th class="px-2 text-right">Qty</th><th class="px-2 text-right">Revenue</th>
                                <th class="px-2 text-right">Recurring</th><th class="px-2 text-right">Discount</th>
                                <th class="px-5 text-right">Win rate</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in _report.ByProduct)
                            {
                                <tr class="border-t border-slate-100">
                                    <td class="px-5 py-2 font-medium">@p.Name <span class="text-xs text-slate-500">@p.Code</span></td>
                                    <td class="px-2 text-slate-600">@p.Category</td>
                                    <td class="px-2 text-right">@p.Quantity.ToString("0.##")</td>
                                    <td class="px-2 text-right">@M(p.Revenue)</td>
                                    <td class="px-2 text-right">@M(p.RecurringRevenue)</td>
                                    <td class="px-2 text-right">@M(p.Discount) <span class="text-xs text-slate-500">(@p.DiscountRatePercent.ToString("0.#")%)</span></td>
                                    <td class="px-5 text-right">@(p.WinRatePercent is { } w ? $"{w:0.#}%" : "—") <span class="text-xs text-slate-500">@p.WonDeals/@(p.WonDeals + p.LostDeals)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="grid gap-6 lg:grid-cols-2">
            <div class="rounded-xl border border-slate-200 bg-white">
                <h2 class="border-b border-slate-200 px-5 py-3 text-sm font-semibold text-slate-900">By category</h2>
                <table class="min-w-full text-sm">
                    <tbody>
                        @foreach (var c in _report.ByCategory)
                        {
                            <tr class="border-t border-slate-100">
                                <td class="px-5 py-2">@c.Category</td>
                                <td class="px-2 text-right">@M(c.Revenue)</td>
                                <td class="px-5 text-right text-xs text-slate-500">@M(c.RecurringRevenue) recurring</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="rounded-xl border border-slate-200 bg-white">
                <h2 class="border-b border-slate-200 px-5 py-3 text-sm font-semibold text-slate-900">Recurring by frequency</h2>
                <table class="min-w-full text-sm">
                    <tbody>
                        @foreach (var r in _report.RecurringByFrequency)
                        {
                            <tr class="border-t border-slate-100">
                                <td class="px-5 py-2">@r.BillingFrequency</td>
                                <td class="px-5 text-right">@M(r.Revenue)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private RevenueReport? _report;
    private string _preset = "thisquarter";
    private string? _error;

    private string M(decimal v) => Presentation.MoneyExact(v, null);

    private static string Deals(int n) => n == 1 ? "1 deal" : $"{n} deals";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Presentation.EnsureLoadedAsync();
        await LoadAsync();
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try { _report = await Api.GetFromJsonAsync<RevenueReport>($"/api/reports/revenue?preset={_preset}&pipelineId=all"); }
        catch (Exception ex) { _error = $"Could not load the report: {ex.Message}"; }
    }
}
