@page "/admin"
@attribute [Authorize]

<PageTitle>Dashboard — IronMonkey Admin</PageTitle>

<div>
    <h1 class="text-2xl font-bold text-slate-900">Dashboard</h1>
    <p class="mt-2 text-slate-500">Welcome to the IronMonkey Admin Console.</p>

    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Placeholder stat cards — Phase 10-13 will replace these with real data -->
        <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-sm font-medium text-slate-500">Recipes</p>
            <p class="mt-1 text-2xl font-bold text-slate-900">—</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-sm font-medium text-slate-500">Tenants</p>
            <p class="mt-1 text-2xl font-bold text-slate-900">—</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-sm font-medium text-slate-500">Pending Signups</p>
            <p class="mt-1 text-2xl font-bold text-slate-900">—</p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5">
            <p class="text-sm font-medium text-slate-500">Active Users</p>
            <p class="mt-1 text-2xl font-bold text-slate-900">—</p>
        </div>
    </div>
</div>
