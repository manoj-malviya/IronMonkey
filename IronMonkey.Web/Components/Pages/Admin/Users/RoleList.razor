@page "/admin/roles"
@attribute [Authorize]
@inject IronMonkey.Web.HttpHandlers.AdminApiClient Api

<PageTitle>Roles — IronMonkey Admin</PageTitle>

<div class="space-y-6">

    <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">Roles</h1>
            <p class="mt-2 text-slate-500">
                Roles in this tenant and the permissions each grants. Built-in roles keep their
                names but their permissions can be changed.
            </p>
        </div>
        <button @onclick="OpenCreate"
                class="rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
            + New Role
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_errorBanner))
    {
        <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@_errorBanner</div>
    }

    @if (!string.IsNullOrEmpty(_successBanner))
    {
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@_successBanner</div>
    }

    @if (_isLoading)
    {
        <div class="py-12 text-center"><p class="text-sm text-slate-500">Loading...</p></div>
    }
    else if (_roles.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 py-16 text-center">
            <p class="text-slate-600">No roles found for this tenant.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto rounded-lg border border-slate-200">
            <table class="w-full">
                <thead class="border-b border-slate-200 bg-slate-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-900">Role</th>
                        <th class="px-6 py-3 text-center text-xs font-semibold uppercase tracking-wide text-slate-900">Users</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-900">Permissions</th>
                        <th class="px-6 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-900">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in _roles)
                    {
                        <tr class="border-b border-slate-100 align-top hover:bg-slate-50">
                            <td class="whitespace-nowrap px-6 py-4 text-sm font-medium text-slate-900">
                                @role.RoleName
                                @if (role.IsSystemRole)
                                {
                                    <span class="ml-2 inline-flex rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-slate-600">Built-in</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-center text-sm text-slate-600">@role.UserCount</td>
                            <td class="px-6 py-4">
                                @if (role.Permissions.Count == 0)
                                {
                                    <span class="text-sm text-slate-400">No permissions granted</span>
                                }
                                else
                                {
                                    <div class="flex flex-wrap gap-1.5">
                                        @foreach (var permission in role.Permissions)
                                        {
                                            <span class="inline-flex items-center rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700">@permission</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="whitespace-nowrap px-6 py-4 text-right space-x-2">
                                <button @onclick="() => OpenEdit(role)"
                                        class="text-sm font-medium text-indigo-600 hover:text-indigo-700">Edit</button>
                                @if (!role.IsSystemRole)
                                {
                                    <button @onclick="() => _deleting = role"
                                            class="text-sm font-medium text-red-600 hover:text-red-700">Delete</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (_showEditor)
{
    <div class="fixed inset-0 z-50 flex items-start justify-center overflow-y-auto bg-black/40 py-10">
        <div class="mx-4 w-full max-w-2xl rounded-xl bg-white p-6 shadow-xl">
            <h3 class="mb-1 text-lg font-semibold text-slate-900">
                @(_editingRoleId is null ? "New Role" : $"Edit {_editorName}")
            </h3>
            <p class="mb-5 text-sm text-slate-500">Choose what this role can do.</p>

            @if (!string.IsNullOrEmpty(_editorError))
            {
                <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">@_editorError</div>
            }

            <div class="mb-5">
                <label class="mb-1 block text-sm font-medium text-slate-700">Role name</label>
                <input type="text" @bind="_editorName" disabled="@_isEditingSystemRole"
                       class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 disabled:bg-slate-50 disabled:text-slate-500" />
                @if (_isEditingSystemRole)
                {
                    <p class="mt-1 text-xs text-slate-500">Built-in roles cannot be renamed.</p>
                }
            </div>

            <div class="space-y-4">
                @foreach (var group in _permissionGroups)
                {
                    <div class="rounded-lg border border-slate-200 p-3">
                        <div class="mb-2 flex items-center justify-between">
                            <span class="text-sm font-semibold capitalize text-slate-900">@group.Key</span>
                            <button type="button" @onclick="() => ToggleGroup(group.Key)"
                                    class="text-xs font-medium text-indigo-600 hover:text-indigo-700">
                                @(AllSelected(group.Key) ? "Clear all" : "Select all")
                            </button>
                        </div>
                        <div class="flex flex-wrap gap-x-5 gap-y-2">
                            @foreach (var p in group)
                            {
                                <label class="flex items-center gap-2">
                                    <input type="checkbox" checked="@_selected.Contains(p.Id)"
                                           @onchange="e => TogglePermission(p.Id, e)"
                                           class="rounded border-slate-300" />
                                    <span class="text-sm capitalize text-slate-700">@p.Action</span>
                                </label>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="mt-6 flex justify-end gap-3">
                <button type="button" @onclick="CloseEditor" class="px-4 py-2 text-sm font-medium text-slate-700">Cancel</button>
                <button type="button" @onclick="SaveAsync" disabled="@_isSaving"
                        class="rounded-lg bg-indigo-600 px-5 py-2 text-sm font-semibold text-white hover:bg-indigo-500 disabled:opacity-60">
                    @(_isSaving ? "Saving..." : "Save Role")
                </button>
            </div>
        </div>
    </div>
}

@if (_deleting is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40">
        <div class="mx-4 w-full max-w-md rounded-xl bg-white p-6 shadow-xl">
            <h3 class="mb-2 text-lg font-semibold text-slate-900">Delete Role</h3>
            <p class="mb-6 text-sm text-slate-600">Delete the role “@_deleting.RoleName”?</p>
            <div class="flex justify-end gap-3">
                <button @onclick="() => _deleting = null" class="px-4 py-2 text-sm font-medium text-slate-700">Cancel</button>
                <button @onclick="ConfirmDeleteAsync" disabled="@_isDeleting"
                        class="rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700 disabled:opacity-60">
                    @(_isDeleting ? "..." : "Delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<RoleItem> _roles = [];
    private List<PermissionItem> _permissions = [];
    private IEnumerable<IGrouping<string, PermissionItem>> _permissionGroups = [];
    private bool _isLoading = true;
    private string? _errorBanner;
    private string? _successBanner;

    private bool _showEditor;
    private int? _editingRoleId;
    private bool _isEditingSystemRole;
    private string _editorName = "";
    private HashSet<int> _selected = [];
    private bool _isSaving;
    private string? _editorError;

    private RoleItem? _deleting;
    private bool _isDeleting;

    protected override async Task OnInitializedAsync()
    {
        _permissions = await Api.GetFromJsonAsync<List<PermissionItem>>("/permissions") ?? [];
        _permissionGroups = _permissions.GroupBy(p => p.Group).OrderBy(g => g.Key).ToList();
        await LoadRolesAsync();
    }

    private async Task LoadRolesAsync()
    {
        _isLoading = true;
        _errorBanner = null;
        try
        {
            _roles = await Api.GetFromJsonAsync<List<RoleItem>>("/users/roles") ?? [];
        }
        catch (Exception ex) { _errorBanner = $"Failed to load roles: {ex.Message}"; }
        finally { _isLoading = false; }
    }

    private void OpenCreate()
    {
        _editingRoleId = null;
        _isEditingSystemRole = false;
        _editorName = "";
        _selected = [];
        _editorError = null;
        _showEditor = true;
    }

    private void OpenEdit(RoleItem role)
    {
        _editingRoleId = role.RoleId;
        _isEditingSystemRole = role.IsSystemRole;
        _editorName = role.RoleName;
        // The role carries permission names; the editor works in ids.
        _selected = _permissions.Where(p => role.Permissions.Contains(p.Name)).Select(p => p.Id).ToHashSet();
        _editorError = null;
        _showEditor = true;
    }

    private void CloseEditor()
    {
        _showEditor = false;
        _editorError = null;
    }

    private void TogglePermission(int id, ChangeEventArgs e)
    {
        if (e.Value is true) _selected.Add(id);
        else _selected.Remove(id);
    }

    private bool AllSelected(string group) =>
        _permissions.Where(p => p.Group == group).All(p => _selected.Contains(p.Id));

    private void ToggleGroup(string group)
    {
        var ids = _permissions.Where(p => p.Group == group).Select(p => p.Id).ToList();
        if (ids.All(_selected.Contains)) foreach (var id in ids) _selected.Remove(id);
        else foreach (var id in ids) _selected.Add(id);
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        _editorError = null;
        try
        {
            var payload = new { Name = _editorName, PermissionIds = _selected.ToList() };
            var res = _editingRoleId is null
                ? await Api.PostAsJsonAsync("/users/roles", payload)
                : await Api.PutAsJsonAsync($"/users/roles/{_editingRoleId}", payload);

            if (res.IsSuccessStatusCode)
            {
                _successBanner = _editingRoleId is null ? "Role created." : "Role updated.";
                _showEditor = false;
                await LoadRolesAsync();
                return;
            }

            _editorError = await ExtractDetailAsync(res);
        }
        catch (Exception ex) { _editorError = $"Unable to save: {ex.Message}"; }
        finally { _isSaving = false; }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleting is null) return;
        _isDeleting = true;
        _errorBanner = null;
        try
        {
            var res = await Api.DeleteAsync($"/users/roles/{_deleting.RoleId}");
            if (res.IsSuccessStatusCode)
            {
                _successBanner = $"Role “{_deleting.RoleName}” deleted.";
                await LoadRolesAsync();
            }
            else _errorBanner = await ExtractDetailAsync(res);
        }
        catch (Exception ex) { _errorBanner = $"Error: {ex.Message}"; }
        finally { _isDeleting = false; _deleting = null; }
    }

    /// <summary>Pulls the human-readable message out of a ProblemDetails body.</summary>
    private static async Task<string> ExtractDetailAsync(HttpResponseMessage res)
    {
        var body = await res.Content.ReadAsStringAsync();
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("detail", out var detail))
                return detail.GetString() ?? body;
        }
        catch (System.Text.Json.JsonException) { }
        return string.IsNullOrWhiteSpace(body) ? $"Request failed ({(int)res.StatusCode})." : body;
    }

    private class RoleItem
    {
        public int RoleId { get; set; }
        public string RoleName { get; set; } = "";
        public List<string> Permissions { get; set; } = [];
        public bool IsSystemRole { get; set; }
        public int UserCount { get; set; }
    }

    private class PermissionItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Group { get; set; } = "";
        public string Action { get; set; } = "";
    }
}
