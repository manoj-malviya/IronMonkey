@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject AdminAuthenticationStateProvider AuthProvider

<CascadingAuthenticationState>
    <!-- Mobile topbar (D-16) -->
    <AdminTopbar OnHamburgerClick="ToggleSidebar" />

    <!-- Sidebar (D-15: fixed desktop, overlay mobile) -->
    <AdminSidebar IsOpen="_sidebarOpen"
                  IsOpenChanged="val => _sidebarOpen = val"
                  IsMobile="_isMobile" />

    <!-- Main content: offset by sidebar width on desktop -->
    <main class="min-h-screen bg-slate-50 md:pl-64">
        @* Impersonation banner: shown on every page while a platform operator is acting
           inside a tenant, so the borrowed identity is never invisible. *@
        @if (AuthProvider.IsImpersonating)
        {
            <div class="sticky top-0 z-20 border-b border-amber-300 bg-amber-100 px-4 py-3 sm:px-6 lg:px-8">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center gap-2 text-sm text-amber-900">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 shrink-0">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                        </svg>
                        <span>
                            Impersonating <span class="font-semibold">@ImpersonationLabel</span> — actions are performed as that tenant.
                        </span>
                    </div>
                    <button type="button" @onclick="StopImpersonatingAsync"
                            class="rounded-lg bg-amber-800 px-3 py-1.5 text-xs font-semibold text-white hover:bg-amber-900">
                        Exit impersonation
                    </button>
                </div>
            </div>
        }

        <div class="px-4 py-6 sm:px-6 lg:px-8">
            @Body
        </div>
    </main>
</CascadingAuthenticationState>

@code {
    private bool _sidebarOpen = false;
    private bool _isMobile = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Detect initial viewport width to set mobile/desktop mode
            var width = await JS.InvokeAsync<int>("eval", "window.innerWidth");
            _isMobile = width < 768;  // D-14: md breakpoint

            // Initialize authentication state after JS interop is available.
            await AuthProvider.InitializeAsync();

            if (AuthProvider.IsImpersonating)
            {
                var state = await AuthProvider.GetAuthenticationStateAsync();
                _impersonatedEmail = state.User.FindFirst(
                    System.Security.Claims.ClaimTypes.Email)?.Value;
            }

            StateHasChanged();
        }
    }

    private void ToggleSidebar()
    {
        _sidebarOpen = !_sidebarOpen;
    }

    // The tenant name set at impersonation time is circuit state and does not survive a
    // reconnect, so fall back to the token's own email claim, which always travels with it.
    private string ImpersonationLabel =>
        AuthProvider.ImpersonatedTenantName
        ?? _impersonatedEmail
        ?? "another tenant";

    private string? _impersonatedEmail;

    private async Task StopImpersonatingAsync()
    {
        await AuthProvider.StopImpersonatingAsync();
    }
}
